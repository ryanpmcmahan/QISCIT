s":{"EN":[]},"ProtectSelectionIds":true,"SurveyName":"QISCIT - Round 1 (For Experts)"}},{"SurveyID":"SV_2tSHzq8H7dTlQWi","Element":"SQ","PrimaryAttribute":"QID1","SecondaryAttribute":"How many degrees does the T gate rotate a qubit's Bloch vector around the Z axis?","TertiaryAttribute":null,"Payload":{"QuestionText":"How many degrees does the T gate rotate a qubit's Bloch vector around the Z axis?","DataExportTag":"Attention Check","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How many degrees does the T gate rotate a qubit's Bloch vector around the Z axis?","Choices":{"1":{"Display":"45 degrees"},"2":{"Display":"90 degrees"},"3":{"Display":"180 degrees"},"4":{"Display":"The T gate does not rotate a qubit about the Z axis"}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1\/SelectableChoice\/1","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">How many degrees does the T gate rotate a qubit's Bloch vector around the Z axis?<\/span> <span class=\"LeftOpDesc\">45 degrees<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1\/SelectableChoice\/1","LogicType":"Question","Operator":"Selected","QuestionID":"QID1","QuestionIDFromLocator":"QID1","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"Validation Failed","libraryID":"UR_40VSyMmcDj4BXed","messageID":"MS_eEyoXcuKiyoisMm","subMessageID":"VE_VALIDATION_FAILED"}}}},"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1","Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"None"},"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_2tSHzq8H7dTlQWi","Element":"SQ","PrimaryAttribute":"QID100","SecondaryAttribute":"The purpose of this research is to develop and validate the content for a new Quantum Information...","TertiaryAttribute":null,"Payload":{"QuestionText":"The purpose of this research is to develop and validate the content for a new <strong>Quantum Information Science Concept Introductory Test (QISCIT)<\/strong>.<br>\n<br>\nAs implied by its name, QISCIT focuses on introductory QIS concepts that can be demonstrated without the formalism or linear algebra required by other quantum assessments. QISCIT has been designed to focus on the following quantum concepts: <em>superposition<\/em>, <em>measurement<\/em>, <em>gate operations<\/em>, <em>entanglement<\/em>, <em>teleportation<\/em>, and <em>decoherence<\/em>.<br>\n<br>\nWe are employing the process of Almanasreh et al. (https:\/\/doi.org\/10.1016\/j.sapharm.2018.03.066) to evaluate the content validity of QISCIT. This process consists of <strong>two rounds<\/strong>: 1) quantifying the content validity of each item and the initial overall instrument based on ratings from experts, such as yourself, to determine which items to delete, modify, or replace, and 2) quantifying the content validity of each revised item and the final overall instrument. Your estimated commitment is a <strong>total of 2 hours<\/strong>: 1 hour for the first round and 1 hour for the second round.&nbsp;<br>\n<br>\nThe development and validation of QISCIT is funded by the National Science Foundation (NSF) Award #2302816: \"Collaborative Research: Advancing Quantum Education by Adaptively Addressing Misconceptions in Virtual Reality\".&nbsp;","DefaultChoices":false,"DataExportTag":"Purpose Text","QuestionID":"QID100","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"The purpose of this research is to develop and validate the content for a new Quantum Information...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_2tSHzq8H7dTlQWi","Element":"SQ","PrimaryAttribute":"QID101","SecondaryAttribute":"Instructions","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>Instructions<\/h2>","DefaultChoices":false,"DataExportTag":"Instruct Header","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Instructions","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID101"}},{"SurveyID":"SV_2tSHzq8H7dTlQWi","Element":"SQ","PrimaryAttribute":"QID102","SecondaryAttribute":"Please rate the glossary above based on content relevance.","TertiaryAttribute":null,"Payload":{"QuestionText":"Please rate the glossary above based on content relevance.","DataExportTag":"Glossary Rating","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Please rate the glossary above based on content relevance.","Choices":{"1":{"Display":"1 - Not Relevant"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4 - Extremely Relevant"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID102"}},{"SurveyID":"SV_2tSHzq8H7dTlQWi","Element":"SQ","PrimaryAttribute":"QID103","SecondaryAttribute":"Please rate the item above based on content relevance.","TertiaryAttribute":null,"Payload":{"QuestionText":"Please rate the item above based on content relevance.","DataExportTag":"AC Rating","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Please rat