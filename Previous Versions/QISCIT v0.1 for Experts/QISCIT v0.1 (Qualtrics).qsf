ute":null,"Payload":{"QuestionText":"Do you have any visual disabilities? Examples include:\n<ul>\n\t<li>Blindness - substantial, uncorrectable loss of vision in both eyes<\/li>\n\t<li>Color blindness - difficulty distinguishing between colors or inability to perceive any color<\/li>\n\t<li>Low vision - poor acuity, tunnel vision, central field loss, or clouded vision<\/li>\n<\/ul>","DefaultChoices":false,"DataExportTag":"EV Visual Disability","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Do you have any visual disabilities? Examples include: Blindness - substantial, uncorrectable los...","Choices":{"1":{"Display":"No, I do not have any visual disabilities."},"2":{"Display":"Yes, I have one or more visual disabilities."},"3":{"Display":"I prefer not to answer."}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID74","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_2tSHzq8H7dTlQWi","Element":"SQ","PrimaryAttribute":"QID75","SecondaryAttribute":"Do you have any neurological disabilities? Examples include: Autism spectrum disorder (ASD) - inv...","TertiaryAttribute":null,"Payload":{"QuestionText":"Do you have any neurological disabilities? Examples include:\n<ul>\n\t<li>Autism spectrum disorder (ASD) - involves impairments of social communication and interaction abilities<\/li>\n\t<li>Intellectual disabilities - involves impairments of intelligence, learning more slowly, or difficulty understanding complex concepts<\/li>\n\t<li>Mental health disabilities - includes anxiety, delirium, depression, paranoia, and schizophrenia<\/li>\n\t<li>Memory impairments - involves limited short-term memory, missing long-term memory, or limited ability to recall language<\/li>\n\t<li>Seizure disorders - includes different types of epilepsy and migraines<\/li>\n<\/ul>","DefaultChoices":false,"DataExportTag":"EV Neuro Disability","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Do you have any neurological disabilities? Examples include: Autism spectrum disorder (ASD) - inv...","Choices":{"1":{"Display":"No, I do not have any neurological disabilities."},"2":{"Display":"Yes, I have one or more neurological disabilities."},"3":{"Display":"I prefer not to answer."}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID75","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_2tSHzq8H7dTlQWi","Element":"SQ","PrimaryAttribute":"QID76","SecondaryAttribute":"Informed Consent","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>Informed Consent<\/h2>","DefaultChoices":false,"DataExportTag":"IC Header","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Informed Consent","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID76"}},{"SurveyID":"SV_2tSHzq8H7dTlQWi","Element":"SQ","PrimaryAttribute":"QID77","SecondaryAttribute":"Please fully review the informed consent form below before deciding whether to proceed with parti...","TertiaryAttribute":null,"Payload":{"QuestionText":"Please fully review the informed consent form below before deciding whether to proceed with participation.<br>\n&nbsp; &nbsp;<br>\n<iframe style=\"width: 100%;height: 850px;border: none;\" src=\"https:\/\/ucf.yul1.qualtrics.com\/ControlPanel\/File.php?F=F_A7QABn7f2czo2J6\"><\/iframe>&nbsp;","DefaultChoices":false,"DataExportTag":"IC Form","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDe