{"Display":"Woman (including Trans Female\/Trans Woman)"},"7":{"Display":"Non-binary"},"8":{"Display":"Rather not say"}},"ChoiceOrder":["5","6","7","8"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":10,"NextAnswerId":1,"QuestionID":"QID82","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_2tSHzq8H7dTlQWi","Element":"SQ","PrimaryAttribute":"QID83","SecondaryAttribute":"Which of these is the highest level of education you have completed?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which of these is the highest level of education you have completed?","DefaultChoices":false,"DataExportTag":"Demo Education","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Which of these is the highest level of education you have completed?","Choices":{"9":{"Display":"No formal qualifications"},"10":{"Display":"Secondary education (e.g., GED\/GCSE)"},"11":{"Display":"High school diploma\/A-levels"},"12":{"Display":"Technical\/community college"},"13":{"Display":"Undergraduate degree (BS\/BSc\/other)"},"14":{"Display":"Graduate degree (MA\/MSc\/MPhil\/other)"},"15":{"Display":"Doctorate degree (PhD\/other)"},"16":{"Display":"Don't know \/ not applicable"}},"ChoiceOrder":["9","10","11","12","13","14","15","16"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":17,"NextAnswerId":1,"QuestionID":"QID83","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_2tSHzq8H7dTlQWi","Element":"SQ","PrimaryAttribute":"QID84","SecondaryAttribute":"Purpose","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>Purpose<\/h2>","DefaultChoices":false,"DataExportTag":"Purpose Header","QuestionID":"QID84","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Purpose","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_2tSHzq8H7dTlQWi","Element":"SQ","PrimaryAttribute":"QID85","SecondaryAttribute":"On the following pages, you will be presented with QISCIT, which includes a glossary of QIS conce...","TertiaryAttribute":null,"Payload":{"QuestionText":"On the following pages, you will be presented with QISCIT, which includes a glossary of QIS concepts and a total of 22 questions grouped by primary concept for your convenience. For each item, we ask that you <strong>rate<\/strong> the item&nbsp;based on content relevance from 1 (\"Not Relevant\") to 4 (\"Extremely Relevant\") and <strong>provide&nbsp;comments<\/strong> and make suggestions regarding the wording of the item. Finally, you will also have the opportunity to <strong>suggest additional items<\/strong> to be added to QISCIT for consideration in round 2.","DefaultChoices":false,"DataExportTag":"Instructions Text","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"On the following pages, you will be presented with QISCIT, which includes a glossary of QIS conce...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID85","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_2tSHzq8H7dTlQWi","Element":"SQ","PrimaryAttribute":"QID86","SecondaryAttribute":"Glossary of Quantum Information Science Concepts","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>Glossary of Quantum Information Science Concepts<\/h2>","DefaultChoices":false,"DataExportTag":"Gloss Header","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Glossary of Quantum Information Science Concepts","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID86"}},{"SurveyID":"SV_2tSHzq8H7dTlQWi","Element":"SQ","PrimaryAttribute":"QID87","SecondaryAttribute":"The following glossary will be available on each page of questions. Please take time to briefly r...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>The following glossary will be available on each page of questions. Please take time to briefly read the glossary and answer the following <u>attention check<\/u> question.<\/strong><br>\n<br>\nWe will ask you to give feedback on the glossary, which will be available to students throughout the assessment. Note that certain concepts have been defined restrictively, such as defining measurement to be in the computational basis, to reduce cognitive load on students.","DefaultChoices":false,"DataExportTag":"Gloss Notice","QuestionID":"QID87","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"The following glossary will be available on each page of questions. Please take time to briefly r...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_2tSHzq8H7dTlQWi","Element":"SQ","PrimaryAttribute":"QID88","SecondaryAttribute":"Quantum Bit (a.k.a. Qubit):\u00a0The basic unit of quantum information. It is the quantum analogue of...","TertiaryAttribute":null,"Payload":{"QuestionText":"<ul>\n\t<li><strong>Quantum Bit<\/strong> (a.k.a. <strong>Qubit<\/strong>):&nbsp;The basic unit of quantum information. It is the quantum analogue of a bit, with two basis states 0 and 1.<\/li>\n\t<li><strong>Superposition<\/strong>: The ability of a quantum system to be in multiple basis states at the same time.<\/li>\n\t<li><strong>Measurement<\/strong>: The act of examining&nbsp;the state of the system. For this test, all measurements are assumed to be performed on a single qubit in the standard computational basis (0 and 1).<\/li>\n\t<li><strong>Bloch Vector:<\/strong> A method of visualizing the state of a qubit by converting its average measurement outcome to a point on or within a sphere.&nbsp;A picture of a Bloch vector is shown below.<br>\n\t<img height=\"400\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_6VBSXgGI8WnPzBY\" style=\"height: 400px; width: 400px;\" width=\"400\">&nbsp;<\/li>\n\t<li><strong>Gate<\/strong>: A quantum operation that can change the state of one or more qubits.<\/li>\n\t<li><strong>X Gate<\/strong>: A quantum gate that rotates the Bloch vector by 180 degrees about the X axis.<\/li>\n\t<li><strong>S Gate:<\/strong> A quantum gate that rotates the Bloch vector by 90 degrees about the Z axis.<\/li>\n\t<li><strong>T Gate:<\/strong> A quantum gate that rotates the Bloch vector by 45 degrees about the Z axis.<\/li>\n\t<li><strong>Hadamard (H) Gate:<\/strong> A quantum gate that rotates the Bloch vector by 180 degrees about the X+Z axis.<\/li>\n\t<li><strong>Controlled Not (CNOT) Gate<\/strong>: A quantum gate that performs an X gate on the target qubit if and only if the control qubit is in state 1.<\/li>\n\t<li><strong>Entanglement<\/strong>: A fundamental quantum property in which&nbsp;two or more qubits are linked such that the state of one qubit&nbsp;depends on the others.<\/li>\n\t<li><strong>Decoherence:<\/strong> A process in which a quantum system's state is linked to its surrounding environment.<\/li>\n<\/ul>","DefaultChoices":false,"DataExportTag":"Gloss Contents","QuestionID":"QID88","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Quantum Bit (a.k.a. Qubit):\u00a0The basic unit of quantum information. It is the quantum analogue of...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_2tSHzq8H7dTlQWi","Element":"SQ","PrimaryAttribute":"QID89","SecondaryAttribute":"Glossary of Quantum Information Science Concepts","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>Glossary of Quantum Information Science Concepts<\/h2>","DefaultChoices":false,"DataExportTag":"Gloss Header ","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Glossary of Quantum Information Science Concepts","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID89"}},{"SurveyID":"SV_2tSHzq8H7dTlQWi","Element":"SQ","PrimaryAttribute":"QID90","SecondaryAttribute":"Quantum Bit (a.k.a. Qubit):\u00a0The basic unit of quantum information. It is the quantum analogue of...","TertiaryAttribute":null,"Payload":{"QuestionText":"<ul>\n\t<li><strong>Quantum Bit<\/strong> (a.k.a. <strong>Qubit<\/strong>):&nbsp;The basic unit of quantum information. It is the quantum analogue of a bit, with two basis states 0 and 1.<\/li>\n\t<li><strong>Superposition<\/strong>: The ability of a quantum system to be in multiple basis states at the same time.<\/li>\n\t<li><strong>Measurement<\/strong>: The act of examining&nbsp;the state of the system. For this test, all measurements are assumed to be performed on a single qubit in the standard computational basis (0 and 1).<\/li>\n\t<li><strong>Bloch Vector:<\/strong> A method of visualizing the state of a qubit by converting its average measurement outcome to a point on or within a sphere.&nbsp;A picture of a Bloch vector is shown below.<br>\n\t<img width=\"400\" style=\"height: 400px; width: 400px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_6VBSXgGI8WnPzBY\" height=\"400\">&nbsp;<\/li>\n\t<li><strong>Gate<\/strong>: A quantum operation that can change the state of one or more qubits.<\/li>\n\t<li><strong>X Gate<\/strong>: A quantum gate that rotates the Bloch vector by 180 degrees about the X axis.<\/li>\n\t<li><strong>S Gate:<\/strong> A quantum gate that rotates the Bloch vector by 90 degrees about the Z axis.<\/li>\n\t<li><strong>T Gate:<\/strong> A quantum gate that rotates the Bloch vector by 45 degrees about the Z axis.<\/li>\n\t<li><strong>Hadamard (H) Gate:<\/strong> A quantum gate that rotates the Bloch vector by 180 degrees about the X+Z axis.<\/li>\n\t<li><strong>Controlled Not (CNOT) Gate<\/strong>: A quantum gate that performs an X gate on the target qubit if and only if the control qubit is in state 1.<\/li>\n\t<li><strong>Entanglement<\/strong>: A fundamental quantum property in which&nbsp;two or more qubits are linked such that the state of one qubit&nbsp;depends on the others.<\/li>\n\t<li><strong>Decoherence:<\/strong> A process in which a quantum system's state is linked to its surrounding environment.<\/li>\n<\/ul>","DefaultChoices":false,"DataExportTag":"Gloss Contents","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Quantum Bit (a.k.a. Qubit):\u00a0The basic unit of quantum information. It is the quantum analogue of...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID90"}},{"SurveyID":"SV_2tSHzq8H7dTlQWi","Element":"SQ","PrimaryAttribute":"QID92","SecondaryAttribute":"QIS Introductory Concept Test","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>QIS Introductory Concept Test<\/h2>","DefaultChoices":false,"DataExportTag":"QISCIT Header","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"QIS Introductory Concept Test","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID92"}},{"SurveyID":"SV_2tSHzq8H7dTlQWi","Element":"SQ","PrimaryAttribute":"QID93","SecondaryAttribute":"We thank you for your time spent taking this survey. Your response has been recorded.","TertiaryAttribute":null,"Payload":{"QuestionText":"We thank you for your time spent taking this survey. Your response has been recorded.","DefaultChoices":false,"DataExportTag":"EoS","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"We thank you for your time spent taking this survey. Your response has been recorded.","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID93"}},{"SurveyID":"SV_2tSHzq8H7dTlQWi","Element":"SQ","PrimaryAttribute":"QID94","SecondaryAttribute":"Are there any relevant QIS concepts not addressed by the previous items?","TertiaryAttribute":null,"Payload":{"QuestionText":"Are there any relevant QIS concepts not addressed by the previous items?","DefaultChoices":false,"DataExportTag":"AdditionalConcepts","QuestionID":"QID94","QuestionType":"TE","Selector":"ESTB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Are there any relevant QIS concepts not addressed by the previous items?","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_2tSHzq8H7dTlQWi","Element":"SQ","PrimaryAttribute":"QID95","SecondaryAttribute":"First Name","TertiaryAttribute":null,"Payload":{"QuestionText":"First Name","DefaultChoices":false,"DataExportTag":"First Name","QuestionID":"QID95","QuestionType":"TE","Selector":"SL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"First Name","Validation":{"S