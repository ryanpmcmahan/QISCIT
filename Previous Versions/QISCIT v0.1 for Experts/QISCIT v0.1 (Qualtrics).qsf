ull,"Payload":{"QuestionText":"<h3>Question #22 (Decoherence)<\/h3>","DefaultChoices":false,"DataExportTag":"Decoherence3 Header","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Question #22 (Decoherence)","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID162"}},{"SurveyID":"SV_2tSHzq8H7dTlQWi","Element":"SQ","PrimaryAttribute":"QID163","SecondaryAttribute":"Please rate the item above based on content relevance.","TertiaryAttribute":null,"Payload":{"QuestionText":"Please rate the item above based on content relevance.","DataExportTag":"Decoherence3 Rating","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Please rate the item above based on content relevance.","Choices":{"1":{"Display":"1 - Not Relevant"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4 - Extremely Relevant"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID163"}},{"SurveyID":"SV_2tSHzq8H7dTlQWi","Element":"SQ","PrimaryAttribute":"QID164","SecondaryAttribute":"Please provide any comments or suggestions regarding the wording of the item above.","TertiaryAttribute":null,"Payload":{"QuestionText":"Please provide any comments or suggestions regarding the wording of the item above.","DefaultChoices":false,"DataExportTag":"Decoherence3 Comment","QuestionType":"TE","Selector":"ESTB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please provide any comments or suggestions regarding the wording of the item above.","Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID164"}},{"SurveyID":"SV_2tSHzq8H7dTlQWi","Element":"SQ","PrimaryAttribute":"QID165","SecondaryAttribute":"Additional Feedback","TertiaryAttribute":null,"Payload":{"QuestionText":"<h3>Additional Feedback<\/h3>","DefaultChoices":false,"DataExportTag":"Add Feedback Header","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Additional Feedback","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID165"}},{"SurveyID":"SV_2tSHzq8H7dTlQWi","Element":"SQ","PrimaryAttribute":"QID166","SecondaryAttribute":"Glossary of Quantum Information Science Concepts","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>Glossary of Quantum Information Science Concepts<\/h2>","DefaultChoices":false,"DataExportTag":"GlossaryHeader2","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Glossary of Quantum Information Science Concepts","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID166"}},{"SurveyID":"SV_2tSHzq8H7dTlQWi","Element":"SQ","PrimaryAttribute":"QID167","SecondaryAttribute":"Quantum Bit (a.k.a. Qubit):\u00a0The basic unit of quantum information. It is the quantum analogue of...","TertiaryAttribute":null,"Payload":{"QuestionText":"<ul>\n\t<li><strong>Quantum Bit<\/strong> (a.k.a. <strong>Qubit<\/strong>):&nbsp;The basic unit of quantum information. It is the quantum analogue of a bit, with two basis states 0 and 1.<\/li>\n\t<li><strong>Superposition<\/strong>: The ability of a quantum system to be in multiple basis states at the same time.<\/li>\n\t<li><strong>Measurement<\/strong>: The act of examining&nbsp;the state of the system. For this test, all measurements are assumed to be performed on a single qubit in the standard computational basis (0 and 1).<\/li>\n\t<li><strong>Bloch Vector:<\/strong> A method of visualizing the state of a qubit by converting its average measurement outcome to a point on or within a sphere.&nbsp;A picture of a Bloch vector is shown below.<br>\n\t<img width=\"400\" style=\"height: 400px; width: 400px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_6VBSXgGI8WnPzBY\" height=\"400\">&nbsp;<\/li>\n\t<li><strong>Gate<\/strong>: A quantum operation that can change the state of one or more qubits.<\/li>\n\t<li><strong>X Gate<\/strong>: A quantum gate that rotates the Bloch vector by 180 degrees about the X axis.<\/li>\n\t<li><strong>S Gate:<\/strong> A quantum gate that rotates the Bloch vector by 90 degrees about the Z axis.<\/li>\n\t<li><strong>T Gate:<\/strong> A quantum gate that rotates the Bloch vector by 45 degrees about the Z axis.<\/li>\n\t<li><strong>Hadamard (H) Gate:<\/strong> A quantum gate that rotates the Bloch vector by 180 degrees about the X+Z axis.<\/li>\n\t<li><strong>Controlled Not (CNOT) Gate<\/strong>: A quantum gate that performs an X gate on the target qubit if and only if the control qubit is in state 1.<\/li>\n\t<li><strong>Entanglement<\/strong>: A fundamental quantum property in which&nbsp;two or more qubits are linked such that the state of one qubit&nbsp;depends on the others.<\/li>\n\t<li><strong>Decoherence:<\/strong> A process in which a quantum system's state is linked to its surrounding environment.<\/li>\n<\/ul>","DefaultChoices":false,"DataExportTag":"Glossary2","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Quantum Bit (a.k.a. Qubit):\u00a0The basic unit of quantum information. It is the quantum analogue of...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID167"}},{"SurveyID":"SV_2tSHzq8H7dTlQWi","Element":"SQ","PrimaryAttribute":"QID168","SecondaryAttribute":"Please provide any additional comments or suggestions regarding the wording of the glossary above.","TertiaryAttribute":null,"Payload":{"QuestionText":"Please provide any additional comments or suggestions regarding the wording of the glossary above.","DefaultChoices":false,"DataExportTag":"GlossaryComment2","QuestionType":"TE","Selector":"ESTB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please provide any additional comments or suggestions regarding the wording of the glossary above.","Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID168"}},{"SurveyID":"SV_2tSHzq8H7dTlQWi","Element":"SQ","PrimaryAttribute":"QID169","SecondaryAttribute":"Glossary of Quantum Information Science Concepts","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>Glossary of Quantum Information Science Concepts<\/h2>","DefaultChoices":false,"DataExportTag":"GlossaryHeader3","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Glossary of Quantum Information Science Concepts","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID169"}},{"SurveyID":"SV_2tSHzq8H7dTlQWi","Element":"SQ","PrimaryAttribute":"QID17","SecondaryAttribute":"How can a qubit be put into superposition starting from state 0?","TertiaryAttribute":null,"Payload":{"QuestionText":"How can a qubit be put into superposition starting from state 0?<br>","DefaultChoices":false,"DataExportTag":"Gates4","QuestionID":"QID17","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How can a qubit be put into superposition starting from state 0?","Choices":{"4":{"Display":"Apply an H gate"},"5":{"Display":"Apply an S gate"},"6":{"Display":"Apply a T gate"},"7":{"Display":"Apply an X gate"}},"ChoiceOrder":["4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[{"ChoiceID":"4","Grades":{"SC_0OJKeRemeTmXSm2":"1"},"index":0}],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"None"}}},{"SurveyID":"SV_2tSHzq8H7dTlQWi","Element":"SQ","PrimaryAttribute":"QID170","SecondaryAttribute":"Quantum Bit (a.k.a. Qubit):\u00a0The basic unit of quantum information. It is the quantum analogue of...","TertiaryAttribute":null,"Payload":{"QuestionText":"<ul>\n\t<li><strong>Quantum Bit<\/strong> (a.k.a. <strong>Qubit<\/strong>):&nbsp;The basic unit of quantum information. It is the quantum analogue of a bit, with two basis states 0 and 1.<\/li>\n\t<li><strong>Superposition<\/strong>: The ability of a quantum system to be in multiple basis states at the same time.<\/li>\n\t<li><strong>Measurement<\/strong>: The act of examining&nbsp;the state of the system. For this test, all measurements are assumed to be performed on a single qubit in the standard computational basis (0 and 1).<\/li>\n\t<li><strong>Bloch Vector:<\/strong> A method of visualizing the state of a qubit by converting its average measurement outcome to a point on or within a sphere.&nbsp;A picture of a Bloch vector is shown below.<br>\n\t<img width=\"400\" style=\"height: 400px; width: 400px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_6VBSXgGI8WnPzBY\" height=\"400\">&nbsp;<\/li>\n\t<li><strong>Gate<\/strong>: A quantum operation that can change the state of one or more qubits.<\/li>\n\t<li><strong>X Gate<\/strong>: A quantum gate that rotates the Bloch vector by 180 degrees about the X axis.<\/li>\n\t<li><strong>S Gate:<\/strong> A quantum gate that rotates the Bloch vector by 90 degrees about the Z axis.<\/li>\n\t<li><strong>T Gate:<\/strong> A quantum gate that rotates the Bloch vector by 45 degrees about the Z axis.<\/li>\n\t<li><strong>Hadamard (H) Gate:<\/strong> A quantum gate that rotates the Bloch vector by 180 degrees about the X+Z axis.<\/li>\n\t<li><strong>Controlled Not (CNOT) Gate<\/strong>: A quantum gate that performs an X gate on the target qubit if and only if the control qubit is in state 1.<\/li>\n\t<li><strong>Entanglement<\/strong>: A fundamental quantum property in which&nbsp;two or more qubits are linked such that the state of one qubit&nbsp;depends on the others.<\/li>\n\t<li><strong>Decoherence:<\/strong> A process in which a quantum system's state is linked to its surrounding environment.<\/li>\n<\/ul>","DefaultChoices":false,"DataExportTag":"Glossary3","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Quantum Bit (a.k.a. Qubit):\u00a0The basic unit of quantum information. It is the quantum analogue of...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID170"}},{"SurveyID":"SV_2tSHzq8H7dTlQWi","Element":"SQ","PrimaryAttribute":"QID171","SecondaryAttribute":"Please provide any additional comments or suggestions regarding the wording of the glossary above.","TertiaryAttribute":null,"Payload":{"QuestionText":"Please provide any additional comments or suggestions regarding the wording of the glossary above.","DefaultChoices":false,"DataExportTag":"GlossaryComment3","QuestionT