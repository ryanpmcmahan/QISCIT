nLibrary":"qualtricsxmb85vfd82d","SkinType":"templated","Skin":{"brandingId":null,"templateId":"*base","overrides":null},"NewScoring":1,"SurveyMetaDescription":"The most powerful, simple and trusted way to gather experience data. Start your journey to experience management and try a free account today.","EOSMessage":null,"ShowExportTags":"false","CollectGeoLocation":"false","PasswordProtection":"No","AnonymizeResponse":"Yes","RefererCheck":"No","BallotBoxStuffingPreventionBehavior":null,"BallotBoxStuffingPreventionMessage":null,"BallotBoxStuffingPreventionMessageLibrary":null,"BallotBoxStuffingPreventionURL":null,"RecaptchaV3":"false","ConfirmStart":false,"AutoConfirmStart":false,"RelevantID":"false","RelevantIDLockoutPeriod":"+30 days","UseCustomSurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessageLibrary":null,"ResponseSummary":"No","EOSMessageLibrary":null,"EOSRedirectURL":"https:\/\/app.prolific.com\/submissions\/complete?cc=CONFGWND","EmailThankYou":"false","ThankYouEmailMessageLibrary":null,"ThankYouEmailMessage":null,"ValidateMessage":"false","ValidationMessageLibrary":null,"InactiveSurvey":"DefaultMessage","PartialDeletion":null,"PartialDataCloseAfter":"LastActivity","InactiveMessageLibrary":null,"InactiveMessage":null,"AvailableLanguages":{"EN":[]}}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID1","SecondaryAttribute":"How many degrees does the T gate rotate a qubit's Bloch vector around the Z axis?","TertiaryAttribute":null,"Payload":{"QuestionText":"How many degrees does the T gate rotate a qubit's Bloch vector around the Z axis?","DataExportTag":"Attention Check","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How many degrees does the T gate rotate a qubit's Bloch vector around the Z axis?","Choices":{"1":{"Display":"45 degrees"},"2":{"Display":"90 degrees"},"3":{"Display":"180 degrees"},"4":{"Display":"The T gate does not rotate around the Z axis"}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1\/SelectableChoice\/1","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">How many degrees does the T gate rotate a qubit's Bloch vector around the Z axis?<\/span> <span class=\"LeftOpDesc\">45 degrees<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1\/SelectableChoice\/1","LogicType":"Question","Operator":"Selected","QuestionID":"QID1","QuestionIDFromLocator":"QID1","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"Validation Failed","libraryID":"UR_40VSyMmcDj4BXed","messageID":"MS_eEyoXcuKiyoisMm","subMessageID":"VE_VALIDATION_FAILED"}}}},"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1","Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"None"},"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID100","SecondaryAttribute":"The purpose of this research is to develop and validate the content for a new Quantum Information...","TertiaryAttribute":null,"Payload":{"QuestionText":"The purpose of this research is to develop and validate the content for a new <strong>Quantum Information Science Concept Introductory Test (QISCIT)<\/strong>.<br \/>\n<br \/>\nAs implied by its name, QISCIT focuses on introductory QIS concepts that can be demonstrated without the formalism or linear algebra required by other quantum assessments. QISCIT has been designed to focus on the following quantum concepts: <i>qubits<\/i>, <em>gates<\/em>, <em>entanglement<\/em>, <em>teleportation<\/em>, and <em>decoherence<\/em>.<br \/>\n<br \/>\nWe are employing the process of Almanasreh et al. (<a href=\"https:\/\/doi.org\/10.1016\/j.sapharm.2018.03.066\">https:\/\/doi.org\/10.1016\/j.sapharm.2018.03.066<\/a>) to evaluate the content validity of QISCIT. This process consists of two rounds: 1) quantifying the content validity of each item and the initial overall instrument based on ratings from experts, such as yourself, to determine which items to delete, modify, or replace, and 2) quantifying the content validity of each revised item and the final overall instrument. Your estimated commitment is a total of 2 hours: 1 hour for the first round and 1 hour for the second round. <strong><span style=\"background-color:#f1c40f;\">This is the second round of the process.<\/span><\/strong><br \/>\n<br \/>\nThe development and validation of QISCIT is funded by the National Science Foundation (NSF) Award #2302816: &quot;Collaborative Research: Advancing Quantum Education by Adaptively Addressing Misconceptions in Virtual Reality&quot;.&nbsp;","DefaultChoices":false,"DataExportTag":"Purpose Text","QuestionID":"QID100","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"The purpose of this research is to develop and validate the content for a new Quantum Information...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID101","SecondaryAttribute":"Instructions","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>Instructions<\/h2>","DefaultChoices":false,"DataExportTag":"Instruct Header","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Instructions","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID101"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID1