des":{"SC_0OJKeRemeTmXSm2":"1"},"index":0}],"Language":[],"NextChoiceId":10,"NextAnswerId":1,"QuestionID":"QID192"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID193","SecondaryAttribute":"Please rate the item above based on content relevance.","TertiaryAttribute":null,"Payload":{"QuestionText":"Please rate the item above based on content relevance.","DataExportTag":"Q23 Rating","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Please rate the item above based on content relevance.","Choices":{"1":{"Display":"1 - Not Relevant"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4 - Extremely Relevant"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID193"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID194","SecondaryAttribute":"Please provide any comments or suggestions regarding the wording of the item above.","TertiaryAttribute":null,"Payload":{"QuestionText":"Please provide any comments or suggestions regarding the wording of the item above.","DefaultChoices":false,"DataExportTag":"Q23 Comments","QuestionType":"TE","Selector":"ESTB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please provide any comments or suggestions regarding the wording of the item above.","Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID194"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID195","SecondaryAttribute":"Email","TertiaryAttribute":null,"Payload":{"QuestionText":"Email","DefaultChoices":false,"DataExportTag":"Email","QuestionID":"QID195","QuestionType":"TE","Selector":"SL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Email","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"ContentType","MinChars":"1","ContentType":"ValidEmail","ValidDateType":"DateWithFormat","ValidPhoneType":"ValidUSPhone","ValidZipType":"ValidUSZip","ValidNumber":{"Min":"","Max":"","NumDecimals":""}}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID196","SecondaryAttribute":"NOTE: We are repeating our glossary here for your convenience.","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong><span style=\"background-color:#f1c40f;\">NOTE: We are repeating our glossary here for your convenience.<\/span><\/strong><\/p>","DefaultChoices":false,"DataExportTag":"GlossaryNote","QuestionID":"QID196","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"NOTE: We are repeating our glossary here for your convenience.","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID20","SecondaryAttribute":"Two qubits are entangled, and then the first qubit is measured. What happened to the entanglement...","TertiaryAttribute":null,"Payload":{"QuestionText":"Two qubits are entangled, and then the first qubit is measured. What happened to the entanglement between the two qubits?","DefaultChoices":false,"DataExportTag":"Q21","QuestionID":"QID20","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Two qubits are entangled, and then the first qubit is measured. What happened to the entanglement...","Choices":{"4":{"Display":"The entanglement decreased to zero"},"5":{"Display":"The entanglement depends on the result of the measurement"},"6":{"Display":"The entanglement increased"},"7":{"Display":"The entanglement remained the same"}},"ChoiceOrder":["4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[{"ChoiceID":"4","Grades":{"SC_0OJKeRemeTmXSm2":"1"},"index":0}],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"None"}}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID202","SecondaryAttribute":"As an emerging field, quantum information science has a rapidly developing vocabulary. In this te...","TertiaryAttribute":null,"Payload":{"QuestionText":"As an emerging field, quantum information science has a rapidly developing vocabulary. In this test, we use specific definitions that capture key concepts. More-general definitions may be encountered in advanced classes.&nbsp;The following glossary presents the specific definitions used through this test but does not contain all the information required to answer the questions.","DefaultChoices":false,"DataExportTag":"Gloss Explanation","QuestionID":"QID202","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"As an emerging field, quantum information science has a rapidly developing vocabulary. In this te...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID204","SecondaryAttribute":"Glossary of Quantum Information Science Concepts","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>Glossary of Quantum Information Science Concepts<\/h2>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Glossary of Quantum Information Science Concepts","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<h2>Glossary of Quantum Information Science Concepts<\/h2>","DataExportTag":"Gloss Header","QuestionID":"QID204","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID205","SecondaryAttribute":"As an emerging field, quantum information science has a rapidly developing vocabulary. In this te...","TertiaryAttribute":null,"Payload":{"QuestionText":"As an emerging field, quantum information science has a rapidly developing vocabulary. In this test, we use specific definitions that capture key concepts. More-general definitions may be encountered in advanced classes.&nbsp;The following glossary presents the specific definitions used through this test but does not contain all the information required to answer the questions.","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"As an emerging field, quantum information science has a rapidly developing vocabulary. In this te...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"As an emerging field, quantum information science has a rapidly developing vocabulary. In this test, we use specific definitions that capture key concepts. More-general definitions may be encountered in advanced classes.&nbsp;The following glossary presents the specific definitions used through this test but does not contain all the information required to answer the questions.<br \/>\n<br \/>\n<strong><span style=\"background-color:#f1c40f;\">Note, there have been several edits to the glossary, so please review it carefully.<\/span><\/strong>","DataExportTag":"Gloss Explanation","QuestionID":"QID205"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID206","SecondaryAttribute":"Quantum Bit (a.k.a. Qubit):\u00a0The basic unit of quantum information. It is the quantum analogue of...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Quantum Bit<\/strong> (a.k.a. <strong>Qubit<\/strong>):&nbsp;The basic unit of quantum information. It is the quantum analogue of a classical bit, with two orthogonal basis states 0 and 1.<br \/>\n<br \/>\n<strong>Superposition<\/strong>: The ability of a quantum system to be in multiple basis states at the same time.<br \/>\n<br \/>\n<strong>Bloch Vector:<\/strong> A method of visualizing the state of a single qubit by converting information about its quantum state to a point on or within a sphere. For more than one qubit, the Bloch vector representation does not always provide complete information. A picture of a Bloch vector is shown here.<br \/>\n<img height=\"308\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_cwEn5lhVvyX0EcK\" style=\"width: 378px; height: 308px;\" width=\"378\" \/><br \/>\n<br \/>\n<strong>Quantum Circuit<\/strong>: A sequence of quantum operations applied to a system of qubits. A picture of a quantum circuit is shown here. The individual concepts (measurements, gates, etc.) are defined below.<br \/>\n<img height=\"211\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_eV6CPaQPQmay38q\" style=\"width: 563px; height: 211px;\" width=\"563\" \/><br \/>\n<br \/>\n<strong>Measurement<\/strong>: The act of examining the state of the system, which causes the system to collapse probabilistically to one of the basis states (0 or 1) of the measured qubit. <em>For this test, all measurements are assumed to be projective measurements of a single qubit in the computational basis.<\/em><br \/>\n<br \/>\n<strong>Quantum Gate<\/strong>: A quantum operation that can change the state of one or more qubits via a generalized rotation. <em>For this test, the term gate will be used exclusively for ideal unitary quantum gates.<\/em><br \/>\n<br \/>\n<strong>X Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the X axis.<br \/>\n&nbsp;<img height=\"46\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_0cwaF932gzHM6qO\" style=\"width: 103px; height: 46px;\" width=\"103\" \/><br \/>\n<br \/>\n<strong>Y Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the Y axis.<br \/>\n&nbsp;<img height=\"47\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_086ndZpcgMGT5mm\" style=\"width: 102px; height: 47px;\" width=\"102\" \/><br \/>\n<br \/>\n<strong>Z Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the Z axis.<br \/>\n&nbsp;<img height=\"50\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_8dJqo62BFUphAFw\" style=\"width: 103px; height: 50px;\" width=\"103\" \/><br \/>\n<br \/>\n<strong>S Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 90 degrees about the Z axis.<br \/>\n&nbsp;<img height=\"47\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_9KUpigbDM7odSwm\" style=\"width: 103px; height: 47px;\" width=\"103\" \/><br \/>\n<br \/>\n<strong>T Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 45 degrees about the Z axis.<br \/>\n&nbsp;<img height=\"46\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_bOx16xZhGtiQpBI\" style=\"width: 103px; height: 46px;\" width=\"103\" \/><br \/>\n<br \/>\n<strong>Hadamard (H) Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the X+Z axis.<br \/>\n&nbsp;<img height=\"46\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_cXWramA5VNfukD4\" style=\"width: 103px; height: 46px;\" width=\"103\" \/><br \/>\n<br \/>\n<strong>Controlled Not (CNOT) Gate<\/strong>: A two-qubit quantum gate that performs an X gate on the target qubit if and only if the control qubit is in state 1.<br \/>\n<img height=\"93\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_6tzjI6DxLbnDf8y\" style=\"width: 200px; height: 93px;\" width=\"200\" \/><br \/>\n<br \/>\n<strong>Entanglement<\/strong>: A fundamental quantum property in which the quantum state is shared among two or more qubits and not a property of any single qubit. When qubits are entangled, measurement of one qubit is influenced by measurements of the other qubits.<br \/>\n<br \/>\n<strong>Bell State<\/strong>: A specific two-qubit state that is maximally entangled. The four Bell states form a useful basis for describing two-qubit states.<br \/>\n<br \/>\n<strong>Quantum Teleportation<\/strong>: A procedure for transmitting quantum information from one location to another using entanglement. A picture of a canonical teleportation circuit is shown here.<br \/>\n<img height=\"192\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_cFHBzotmjj1OhCe\" style=\"width: 711px; height: 192px;\" width=\"711\" \/><br \/>\n<br \/>\n<strong>Decoherence<\/strong>: A process in which a quantum system&#39;s state loses information due to interactions with its surrounding environment. <em>For this test, all decoherence is assumed to be of Lindblad form (non-unitary, Markovian) such that dynamic decoupling does not protect against it. Noise from imperfect gates is considered as a form of decoherence.<\/em>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Quantum Bit (a.k.a. Qubit):\u00a0The basic unit of quantum information. It is the quantum analogue of...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false},"QuestionText_Unsafe":"<strong>Quantum Bit<\/strong> (a.k.a. <strong>Qubit<\/strong>):&nbsp;The basic unit of quantum information. It is the quantum analogue of a classical bit, with two orthogonal basis states 0 and 1.<br \/>\n<br \/>\n<strong>Superposition<\/strong>: The ability of a quantum system to be in multiple basis states at the same time.<br \/>\n<br \/>\n<strong>Bloch Vector:<\/strong> A method of visualizing the state of a single qubit by converting information about its quantum state to a point on or within a sphere. For more than one qubit, the Bloch vector representation does not always provide complete information. A picture of a Bloch vector is shown here.<br \/>\n<img height=\"308\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_cwEn5lhVvyX0EcK\" style=\"width: 378px; height: 308px;\" width=\"378\" \/><br \/>\n<br \/>\n<strong>Quantum Circuit<\/strong>: A sequence of quantum operations applied to a system of qubits. A picture of a quantum circuit is shown here. The individual concepts (measurements, gates, etc.) are defined below.<br \/>\n<img height=\"211\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_eV6CPaQPQmay38q\" style=\"width: 563px; height: 211px;\" width=\"563\" \/><br \/>\n<br \/>\n<strong>Measurement<\/strong>: The act of examining the state of the system, which causes the system to collapse probabilistically to one of the basis states (0 or 1) of the measured qubit. <em>For this test, all measurements are assumed to be projective measurements of a single qubit in the computational basis.<\/em><br \/>\n<br \/>\n<strong>Quantum Gate<\/strong>: A quantum operation that can change the state of one or more qubits via a generalized rotation. <em>For this test, the term gate will be used exclusively for ideal unitary quantum gates.<\/em><br \/>\n<br \/>\n<strong>X Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the X axis.<br \/>\n&nbsp;<img height=\"46\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_0cwaF932gzHM6qO\" style=\"width: 103px; height: 46px;\" width=\"103\" \/><br \/>\n<br \/>\n<strong>Y Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the Y axis.<br \/>\n&nbsp;<img height=\"47\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_086ndZpcgMGT5mm\" style=\"width: 102px; height: 47px;\" width=\"102\" \/><br \/>\n<br \/>\n<strong>Z Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the Z axis.<br \/>\n&nbsp;<img height=\"50\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_8dJqo62BFUphAFw\" style=\"width: 103px; height: 50px;\" width=\"103\" \/><br \/>\n<br \/>\n<strong>S Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 90 degrees about the Z axis.<br \/>\n&nbsp;<img height=\"47\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_9KUpigbDM7odSwm\" style=\"width: 103px; height: 47px;\" width=\"103\" \/><br \/>\n<br \/>\n<strong>T Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 45 degrees about the Z axis.<br \/>\n&nbsp;<img height=\"46\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_bOx16xZhGtiQpBI\" style=\"width: 103px; height: 46px;\" width=\"103\" \/><br \/>\n<br \/>\n<strong>Hadamard (H) Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the X+Z axis.<br \/>\n&nbsp;<img height=\"46\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_cXWramA5VNfukD4\" style=\"width: 103px; height: 46px;\" width=\"103\" \/><br \/>\n<br \/>\n<strong>Controlled Not (CNOT) Gate<\/strong>: A two-qubit quantum gate that performs an X gate on the target qubit if and only if the control qubit is in state 1.<br \/>\n<img height=\"93\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_6tzjI6DxLbnDf8y\" style=\"width: 200px; height: 93px;\" width=\"200\" \/><br \/>\n<br \/>\n<strong>Entanglement<\/strong>: A fundamental quantum property in which the quantum state is shared among two or more qubits and not a property of any single qubit. When qubits are entangled, the measurements of one qubit are is influenced by measurements of othersthe other qubits.<br \/>\n<br \/>\n<strong>Bell State<\/strong>: A specific two-qubit state that is maximally entangled. The four Bell states form a useful basis for describing two-qubit states.<br \/>\n<br \/>\n<strong>Quantum Teleportation<\/strong>: A procedure for transmitting quantum information from one location to another using entanglement. A picture of a canonical teleportation circuit is shown here.<br \/>\n<img height=\"192\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_cFHBzotmjj1OhCe\" style=\"width: 711px; height: 192px;\" width=\"711\" \/><br \/>\n<br \/>\n<strong>Decoherence<\/strong>: A process in which a quantum system&#39;s state loses information due to interactions with its surrounding environment. <em>For this test, all decoherence is assumed to be of Lindblad form (non-unitary, Markovian) such that dynamic decoupling does not protect against it. Noise from imperfect gates is considered as a form of decoherence.<\/em>","DataExportTag":"Gloss Contents","QuestionID":"QID206"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID208","SecondaryAttribute":"Provide any additional comments or suggestions regarding the wording of the glossary here.","TertiaryAttribute":null,"Payload":{"QuestionText":"Provide any additional comments or suggestions regarding the wording of the glossary here.","DefaultChoices":false,"QuestionType":"TE","Selector":"ESTB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Provide any additional comments or suggestions regarding the wording of the glossary here.","Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"Please provide any comments or suggestions regarding the wording of the glossary above.","DataExportTag":"Glossary Comments","QuestionID":"QID208"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID21","SecondaryAttribute":"Two qubits each start in state 0. An H gate is applied to the first qubit. A CNOT gate is then ap...","TertiaryAttribute":null,"Payload":{"QuestionText":"Two qubits each start in state 0. An H gate is applied to the first qubit. A CNOT gate is then applied, using the first qubit as the control and the second qubit as the target. The second qubit is measured, which returns state 0. If the first qubit is then measured, what is the probability it will return state 0?<br \/>\n<img height=\"99\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_2tTjpcJaemwZDgi\" style=\"width: 340px; height: 99px;\" width=\"340\" \/>","DefaultChoices":false,"DataExportTag":"Q22","QuestionID":"QID21","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Two qubits each start in state 0. An H gate is applied to the first qubit. A CNOT gate is then ap...","Choices":{"4":{"Display":"0%"},"5":{"Display":"25%"},"7":{"Display":"75%"},"8":{"Display":"50%"},"9":{"Display":"100%"}},"ChoiceOrder":["4","5","8","7","9"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[{"ChoiceID":"9","Grades":{"SC_0OJKeRemeTmXSm2":"1"},"index":0}],"Language":[],"NextChoiceId":10,"NextAnswerId":1,"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"None"}}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID212","SecondaryAttribute":"Gates","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>Gates<\/h2>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Gates","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<h2>Qubits<\/h2>","DataExportTag":"Gates Header","QuestionID":"QID212"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID213","SecondaryAttribute":"NOTE: We are repeating our glossary here for your convenience.","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong><span style=\"background-color:#f1c40f;\">NOTE: We are repeating our glossary here for your convenience.<\/span><\/strong><\/p>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"NOTE: We are repeating our glossary here for your convenience.","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<p><strong><span style=\"background-color:#f1c40f;\">NOTE: We are repeating our glossary here for your convenience.<\/span><\/strong><\/p>","DataExportTag":"Gloss Note","QuestionID":"QID213"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID214","SecondaryAttribute":"Glossary of Quantum Information Science Concepts","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>Glossary of Quantum Information Science Concepts<\/h2>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Glossary of Quantum Information Science Concepts","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<h2>Glossary of Quantum Information Science Concepts<\/h2>","DataVisibility":{"Private":false,"Hidden":false},"DataExportTag":"Gloss Header","QuestionID":"QID214"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID215","SecondaryAttribute":"As an emerging field, quantum information science has a rapidly developing vocabulary. In this te...","TertiaryAttribute":null,"Payload":{"QuestionText":"As an emerging field, quantum information science has a rapidly developing vocabulary. In this test, we use specific definitions that capture key concepts. More-general definitions may be encountered in advanced classes.&nbsp;The following glossary presents the specific definitions used through this test but does not contain all the information required to answer the questions.","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"As an emerging field, quantum information science has a rapidly developing vocabulary. In this te...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"As an emerging field, quantum information science has a rapidly developing vocabulary. In this test, we use specific definitions that capture key concepts. More-general definitions may be encountered in advanced classes.&nbsp;The following glossary presents the specific definitions used through this test but does not contain all the information required to answer the questions.","DataExportTag":"Gloss Explanation","QuestionID":"QID215"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID216","SecondaryAttribute":"Quantum Bit (a.k.a. Qubit):\u00a0The basic unit of quantum information. It is the quantum analogue of...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Quantum Bit<\/strong> (a.k.a. <strong>Qubit<\/strong>):&nbsp;The basic unit of quantum information. It is the quantum analogue of a classical bit, with two orthogonal basis states 0 and 1.<br>\n<br>\n<strong>Superposition<\/strong>: The ability of a quantum system to be in multiple basis states at the same time.<br>\n<br>\n<strong>Bloch Vector:<\/strong> A method of visualizing the state of a single qubit by converting information about its quantum state to a point on or within a sphere. For more than one qubit, the Bloch vector representation does not always provide complete information. A picture of a Bloch vector is shown here.<br>\n<img width=\"378\" style=\"width: 378px; height: 308px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_cwEn5lhVvyX0EcK\" height=\"308\"><br>\n<br>\n<strong>Quantum Circuit<\/strong>: A sequence of quantum operations applied to a system of qubits. A picture of a quantum circuit is shown here. The individual concepts (measurements, gates, etc.) are defined below.<br>\n<img width=\"563\" style=\"width: 563px; height: 211px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_eV6CPaQPQmay38q\" height=\"211\"><br>\n<br>\n<strong>Measurement<\/strong>: The act of examining the state of the system, which causes the system to collapse probabilistically to one of the basis states (0 or 1) of the measured qubit. <em>For this test, all measurements are assumed to be projective measurements of a single qubit in the computational basis.<\/em><br>\n<br>\n<strong>Quantum Gate<\/strong>: A quantum operation that can change the state of one or more qubits via a generalized rotation. <em>For this test, the term gate will be used exclusively for ideal unitary quantum gates.<\/em><br>\n<br>\n<strong>X Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the X axis.<br>\n&nbsp;<img width=\"103\" style=\"width: 103px; height: 46px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_0cwaF932gzHM6qO\" height=\"46\"><br>\n<br>\n<strong>Y Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the Y axis.<br>\n&nbsp;<img width=\"102\" style=\"width: 102px; height: 47px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_086ndZpcgMGT5mm\" height=\"47\"><br>\n<br>\n<strong>Z Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the Z axis.<br>\n&nbsp;<img width=\"103\" style=\"width: 103px; height: 50px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_8dJqo62BFUphAFw\" height=\"50\"><br>\n<br>\n<strong>S Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 90 degrees about the Z axis.<br>\n&nbsp;<img width=\"103\" style=\"width: 103px; height: 47px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_9KUpigbDM7odSwm\" height=\"47\"><br>\n<br>\n<strong>T Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 45 degrees about the Z axis.<br>\n&nbsp;<img width=\"103\" style=\"width: 103px; height: 46px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_bOx16xZhGtiQpBI\" height=\"46\"><br>\n<br>\n<strong>Hadamard (H) Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the X+Z axis.<br>\n&nbsp;<img width=\"103\" style=\"width: 103px; height: 46px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_cXWramA5VNfukD4\" height=\"46\"><br>\n<br>\n<strong>Controlled Not (CNOT) Gate<\/strong>: A two-qubit quantum gate that performs an X gate on the target qubit if and only if the control qubit is in state 1.<br>\n<img width=\"200\" style=\"width: 200px; height: 93px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_6tzjI6DxLbnDf8y\" height=\"93\"><br>\n<br>\n<strong>Entanglement<\/strong>: A fundamental quantum property in which the quantum state is shared among two or more qubits and not a property of any single qubit. When qubits are entangled, measurement of one qubit is influenced by measurements of the other qubits.<br>\n<br>\n<strong>Bell State<\/strong>: A specific two-qubit state that is maximally entangled. The four Bell states form a useful basis for describing two-qubit states.<br>\n<br>\n<strong>Quantum Teleportation<\/strong>: A procedure for transmitting quantum information from one location to another using entanglement. A picture of a canonical teleportation circuit is shown here.<br>\n<img width=\"711\" style=\"width: 711px; height: 192px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_cFHBzotmjj1OhCe\" height=\"192\"><br>\n<br>\n<strong>Decoherence<\/strong>: A process in which a quantum system's state loses information due to interactions with its surrounding environment. <em>For this test, all decoherence is assumed to be of Lindblad form (non-unitary, Markovian) such that dynamic decoupling does not protect against it. Noise from imperfect gates is considered as a form of decoherence.<\/em>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Quantum Bit (a.k.a. Qubit):\u00a0The basic unit of quantum information. It is the quantum analogue of...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false},"QuestionText_Unsafe":"<strong>Quantum Bit<\/strong> (a.k.a. <strong>Qubit<\/strong>):&nbsp;The basic unit of quantum information. It is the quantum analogue of a classical bit, with two orthogonal basis states 0 and 1.<br \/>\n<br \/>\n<strong>Superposition<\/strong>: The ability of a quantum system to be in multiple basis states at the same time.<br \/>\n<br \/>\n<strong>Bloch Vector:<\/strong> A method of visualizing the state of a single qubit by converting information about its quantum state to a point on or within a sphere. For more than one qubit, the Bloch vector representation does not always provide complete information. A picture of a Bloch vector is shown here.<br \/>\n<img height=\"308\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_cwEn5lhVvyX0EcK\" style=\"width: 378px; height: 308px;\" width=\"378\" \/><br \/>\n<br \/>\n<strong>Quantum Circuit<\/strong>: A sequence of quantum operations applied to a system of qubits. A picture of a quantum circuit is shown here. The individual concepts (measurements, gates, etc.) are defined below.<br \/>\n<img height=\"211\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_eV6CPaQPQmay38q\" style=\"width: 563px; height: 211px;\" width=\"563\" \/><br \/>\n<br \/>\n<strong>Measurement<\/strong>: The act of examining the state of the system, which causes the system to collapse probabilistically to one of the basis states (0 or 1) of the measured qubit. <em>For this test, all measurements are assumed to be projective measurements of a single qubit in the computational basis.<\/em><br \/>\n<br \/>\n<strong>Quantum Gate<\/strong>: A quantum operation that can change the state of one or more qubits via a generalized rotation. <em>For this test, the term gate will be used exclusively for ideal unitary quantum gates.<\/em><br \/>\n<br \/>\n<strong>X Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the X axis.<br \/>\n&nbsp;<img height=\"46\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_0cwaF932gzHM6qO\" style=\"width: 103px; height: 46px;\" width=\"103\" \/><br \/>\n<br \/>\n<strong>Y Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the Y axis.<br \/>\n&nbsp;<img height=\"47\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_086ndZpcgMGT5mm\" style=\"width: 102px; height: 47px;\" width=\"102\" \/><br \/>\n<br \/>\n<strong>Z Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the Z axis.<br \/>\n&nbsp;<img height=\"50\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_8dJqo62BFUphAFw\" style=\"width: 103px; height: 50px;\" width=\"103\" \/><br \/>\n<br \/>\n<strong>S Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 90 degrees about the Z axis.<br \/>\n&nbsp;<img height=\"47\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_9KUpigbDM7odSwm\" style=\"width: 103px; height: 47px;\" width=\"103\" \/><br \/>\n<br \/>\n<strong>T Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 45 degrees about the Z axis.<br \/>\n&nbsp;<img height=\"46\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_bOx16xZhGtiQpBI\" style=\"width: 103px; height: 46px;\" width=\"103\" \/><br \/>\n<br \/>\n<strong>Hadamard (H) Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the X+Z axis.<br \/>\n&nbsp;<img height=\"46\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_cXWramA5VNfukD4\" style=\"width: 103px; height: 46px;\" width=\"103\" \/><br \/>\n<br \/>\n<strong>Controlled Not (CNOT) Gate<\/strong>: A two-qubit quantum gate that performs an X gate on the target qubit if and only if the control qubit is in state 1.<br \/>\n<img height=\"93\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_6tzjI6DxLbnDf8y\" style=\"width: 200px; height: 93px;\" width=\"200\" \/><br \/>\n<br \/>\n<strong>Entanglement<\/strong>: A fundamental quantum property in which the quantum state is shared among two or more qubits and not a property of any single qubit. When qubits are entangled, the measurements of one qubit are is influenced by measurements of othersthe other qubits.<br \/>\n<br \/>\n<strong>Bell State<\/strong>: A specific two-qubit state that is maximally entangled. The four Bell states form a useful basis for describing two-qubit states.<br \/>\n<br \/>\n<strong>Quantum Teleportation<\/strong>: A procedure for transmitting quantum information from one location to another using entanglement. A picture of a canonical teleportation circuit is shown here.<br \/>\n<img height=\"192\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_cFHBzotmjj1OhCe\" style=\"width: 711px; height: 192px;\" width=\"711\" \/><br \/>\n<br \/>\n<strong>Decoherence<\/strong>: A process in which a quantum system&#39;s state loses information due to interactions with its surrounding environment. <em>For this test, all decoherence is assumed to be of Lindblad form (non-unitary, Markovian) such that dynamic decoupling does not protect against it. Noise from imperfect gates is considered as a form of decoherence.<\/em>","DataExportTag":"Gloss Contents","QuestionID":"QID216"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID217","SecondaryAttribute":"Provide any additional comments or suggestions regarding the wording of the glossary here.","TertiaryAttribute":null,"Payload":{"QuestionText":"Provide any additional comments or suggestions regarding the wording of the glossary here.","DefaultChoices":false,"QuestionType":"TE","Selector":"ESTB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Provide any additional comments or suggestions regarding the wording of the glossary here.","Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"Provide any additional comments or suggestions regarding the wording of the glossary here.","DataExportTag":"Glossary Comments ","QuestionID":"QID217"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID218","SecondaryAttribute":"Entanglement","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>Entanglement<\/h2>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Entanglement","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<h2>Gates<\/h2>","DataExportTag":"Entanglement Header","QuestionID":"QID218"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID219","SecondaryAttribute":"NOTE: We are repeating our glossary here for your convenience.","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong><span style=\"background-color:#f1c40f;\">NOTE: We are repeating our glossary here for your convenience.<\/span><\/strong><\/p>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"NOTE: We are repeating our glossary here for your convenience.","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<p><strong><span style=\"background-color:#f1c40f;\">NOTE: We are repeating our glossary here for your convenience.<\/span><\/strong><\/p>","DataExportTag":"Gloss Note","QuestionID":"QID219"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID22","SecondaryAttribute":"What piece of quantum information does the following quantum teleportation circuit transfer from...","TertiaryAttribute":null,"Payload":{"QuestionText":"What piece of quantum information does the following quantum teleportation circuit transfer from location L1 to location L2?<br \/>\n<img height=\"192\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_8wSOSx3kOesFWlM\" style=\"width: 711px; height: 192px;\" width=\"711\" \/>","DefaultChoices":false,"DataExportTag":"Q27","QuestionID":"QID22","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What piece of quantum information does the following quantum teleportation circuit transfer from...","Choices":{"10":{"Display":"Any two-qubit state"},"11":{"Display":"Any Bell state"},"12":{"Display":"Any three-qubit state"},"13":{"Display":"Any single-qubit state"}},"ChoiceOrder":["11","13","10","12"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[{"ChoiceID":"13","Grades":{"SC_0OJKeRemeTmXSm2":"1"},"index":0}],"Language":[],"NextChoiceId":14,"NextAnswerId":1,"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"None"}}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID220","SecondaryAttribute":"Glossary of Quantum Information Science Concepts","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>Glossary of Quantum Information Science Concepts<\/h2>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Glossary of Quantum Information Science Concepts","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<h2>Glossary of Quantum Information Science Concepts<\/h2>","DataVisibility":{"Private":false,"Hidden":false},"DataExportTag":"Gloss Header","QuestionID":"QID220"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID221","SecondaryAttribute":"As an emerging field, quantum information science has a rapidly developing vocabulary. In this te...","TertiaryAttribute":null,"Payload":{"QuestionText":"As an emerging field, quantum information science has a rapidly developing vocabulary. In this test, we use specific definitions that capture key concepts. More-general definitions may be encountered in advanced classes.&nbsp;The following glossary presents the specific definitions used through this test but does not contain all the information required to answer the questions.","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"As an emerging field, quantum information science has a rapidly developing vocabulary. In this te...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"As an emerging field, quantum information science has a rapidly developing vocabulary. In this test, we use specific definitions that capture key concepts. More-general definitions may be encountered in advanced classes.&nbsp;The following glossary presents the specific definitions used through this test but does not contain all the information required to answer the questions.","DataExportTag":"Gloss Explanation","QuestionID":"QID221"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID222","SecondaryAttribute":"Quantum Bit (a.k.a. Qubit):\u00a0The basic unit of quantum information. It is the quantum analogue of...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Quantum Bit<\/strong> (a.k.a. <strong>Qubit<\/strong>):&nbsp;The basic unit of quantum information. It is the quantum analogue of a classical bit, with two orthogonal basis states 0 and 1.<br>\n<br>\n<strong>Superposition<\/strong>: The ability of a quantum system to be in multiple basis states at the same time.<br>\n<br>\n<strong>Bloch Vector:<\/strong> A method of visualizing the state of a single qubit by converting information about its quantum state to a point on or within a sphere. For more than one qubit, the Bloch vector representation does not always provide complete information. A picture of a Bloch vector is shown here.<br>\n<img width=\"378\" style=\"width: 378px; height: 308px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_cwEn5lhVvyX0EcK\" height=\"308\"><br>\n<br>\n<strong>Quantum Circuit<\/strong>: A sequence of quantum operations applied to a system of qubits. A picture of a quantum circuit is shown here. The individual concepts (measurements, gates, etc.) are defined below.<br>\n<img width=\"563\" style=\"width: 563px; height: 211px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_eV6CPaQPQmay38q\" height=\"211\"><br>\n<br>\n<strong>Measurement<\/strong>: The act of examining the state of the system, which causes the system to collapse probabilistically to one of the basis states (0 or 1) of the measured qubit. <em>For this test, all measurements are assumed to be projective measurements of a single qubit in the computational basis.<\/em><br>\n<br>\n<strong>Quantum Gate<\/strong>: A quantum operation that can change the state of one or more qubits via a generalized rotation. <em>For this test, the term gate will be used exclusively for ideal unitary quantum gates.<\/em><br>\n<br>\n<strong>X Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the X axis.<br>\n&nbsp;<img width=\"103\" style=\"width: 103px; height: 46px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_0cwaF932gzHM6qO\" height=\"46\"><br>\n<br>\n<strong>Y Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the Y axis.<br>\n&nbsp;<img width=\"102\" style=\"width: 102px; height: 47px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_086ndZpcgMGT5mm\" height=\"47\"><br>\n<br>\n<strong>Z Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the Z axis.<br>\n&nbsp;<img width=\"103\" style=\"width: 103px; height: 50px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_8dJqo62BFUphAFw\" height=\"50\"><br>\n<br>\n<strong>S Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 90 degrees about the Z axis.<br>\n&nbsp;<img width=\"103\" style=\"width: 103px; height: 47px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_9KUpigbDM7odSwm\" height=\"47\"><br>\n<br>\n<strong>T Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 45 degrees about the Z axis.<br>\n&nbsp;<img width=\"103\" style=\"width: 103px; height: 46px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_bOx16xZhGtiQpBI\" height=\"46\"><br>\n<br>\n<strong>Hadamard (H) Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the X+Z axis.<br>\n&nbsp;<img width=\"103\" style=\"width: 103px; height: 46px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_cXWramA5VNfukD4\" height=\"46\"><br>\n<br>\n<strong>Controlled Not (CNOT) Gate<\/strong>: A two-qubit quantum gate that performs an X gate on the target qubit if and only if the control qubit is in state 1.<br>\n<img width=\"200\" style=\"width: 200px; height: 93px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_6tzjI6DxLbnDf8y\" height=\"93\"><br>\n<br>\n<strong>Entanglement<\/strong>: A fundamental quantum property in which the quantum state is shared among two or more qubits and not a property of any single qubit. When qubits are entangled, measurement of one qubit is influenced by measurements of the other qubits.<br>\n<br>\n<strong>Bell State<\/strong>: A specific two-qubit state that is maximally entangled. The four Bell states form a useful basis for describing two-qubit states.<br>\n<br>\n<strong>Quantum Teleportation<\/strong>: A procedure for transmitting quantum information from one location to another using entanglement. A picture of a canonical teleportation circuit is shown here.<br>\n<img width=\"711\" style=\"width: 711px; height: 192px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_cFHBzotmjj1OhCe\" height=\"192\"><br>\n<br>\n<strong>Decoherence<\/strong>: A process in which a quantum system's state loses information due to interactions with its surrounding environment. <em>For this test, all decoherence is assumed to be of Lindblad form (non-unitary, Markovian) such that dynamic decoupling does not protect against it. Noise from imperfect gates is considered as a form of decoherence.<\/em>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Quantum Bit (a.k.a. Qubit):\u00a0The basic unit of quantum information. It is the quantum analogue of...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false},"QuestionText_Unsafe":"<strong>Quantum Bit<\/strong> (a.k.a. <strong>Qubit<\/strong>):&nbsp;The basic unit of quantum information. It is the quantum analogue of a classical bit, with two orthogonal basis states 0 and 1.<br \/>\n<br \/>\n<strong>Superposition<\/strong>: The ability of a quantum system to be in multiple basis states at the same time.<br \/>\n<br \/>\n<strong>Bloch Vector:<\/strong> A method of visualizing the state of a single qubit by converting information about its quantum state to a point on or within a sphere. For more than one qubit, the Bloch vector representation does not always provide complete information. A picture of a Bloch vector is shown here.<br \/>\n<img height=\"308\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_cwEn5lhVvyX0EcK\" style=\"width: 378px; height: 308px;\" width=\"378\" \/><br \/>\n<br \/>\n<strong>Quantum Circuit<\/strong>: A sequence of quantum operations applied to a system of qubits. A picture of a quantum circuit is shown here. The individual concepts (measurements, gates, etc.) are defined below.<br \/>\n<img height=\"211\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_eV6CPaQPQmay38q\" style=\"width: 563px; height: 211px;\" width=\"563\" \/><br \/>\n<br \/>\n<strong>Measurement<\/strong>: The act of examining the state of the system, which causes the system to collapse probabilistically to one of the basis states (0 or 1) of the measured qubit. <em>For this test, all measurements are assumed to be projective measurements of a single qubit in the computational basis.<\/em><br \/>\n<br \/>\n<strong>Quantum Gate<\/strong>: A quantum operation that can change the state of one or more qubits via a generalized rotation. <em>For this test, the term gate will be used exclusively for ideal unitary quantum gates.<\/em><br \/>\n<br \/>\n<strong>X Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the X axis.<br \/>\n&nbsp;<img height=\"46\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_0cwaF932gzHM6qO\" style=\"width: 103px; height: 46px;\" width=\"103\" \/><br \/>\n<br \/>\n<strong>Y Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the Y axis.<br \/>\n&nbsp;<img height=\"47\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_086ndZpcgMGT5mm\" style=\"width: 102px; height: 47px;\" width=\"102\" \/><br \/>\n<br \/>\n<strong>Z Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the Z axis.<br \/>\n&nbsp;<img height=\"50\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_8dJqo62BFUphAFw\" style=\"width: 103px; height: 50px;\" width=\"103\" \/><br \/>\n<br \/>\n<strong>S Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 90 degrees about the Z axis.<br \/>\n&nbsp;<img height=\"47\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_9KUpigbDM7odSwm\" style=\"width: 103px; height: 47px;\" width=\"103\" \/><br \/>\n<br \/>\n<strong>T Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 45 degrees about the Z axis.<br \/>\n&nbsp;<img height=\"46\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_bOx16xZhGtiQpBI\" style=\"width: 103px; height: 46px;\" width=\"103\" \/><br \/>\n<br \/>\n<strong>Hadamard (H) Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the X+Z axis.<br \/>\n&nbsp;<img height=\"46\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_cXWramA5VNfukD4\" style=\"width: 103px; height: 46px;\" width=\"103\" \/><br \/>\n<br \/>\n<strong>Controlled Not (CNOT) Gate<\/strong>: A two-qubit quantum gate that performs an X gate on the target qubit if and only if the control qubit is in state 1.<br \/>\n<img height=\"93\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_6tzjI6DxLbnDf8y\" style=\"width: 200px; height: 93px;\" width=\"200\" \/><br \/>\n<br \/>\n<strong>Entanglement<\/strong>: A fundamental quantum property in which the quantum state is shared among two or more qubits and not a property of any single qubit. When qubits are entangled, the measurements of one qubit are is influenced by measurements of othersthe other qubits.<br \/>\n<br \/>\n<strong>Bell State<\/strong>: A specific two-qubit state that is maximally entangled. The four Bell states form a useful basis for describing two-qubit states.<br \/>\n<br \/>\n<strong>Quantum Teleportation<\/strong>: A procedure for transmitting quantum information from one location to another using entanglement. A picture of a canonical teleportation circuit is shown here.<br \/>\n<img height=\"192\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_cFHBzotmjj1OhCe\" style=\"width: 711px; height: 192px;\" width=\"711\" \/><br \/>\n<br \/>\n<strong>Decoherence<\/strong>: A process in which a quantum system&#39;s state loses information due to interactions with its surrounding environment. <em>For this test, all decoherence is assumed to be of Lindblad form (non-unitary, Markovian) such that dynamic decoupling does not protect against it. Noise from imperfect gates is considered as a form of decoherence.<\/em>","DataExportTag":"Gloss Contents","QuestionID":"QID222"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID223","SecondaryAttribute":"Provide any additional comments or suggestions regarding the wording of the glossary here.","TertiaryAttribute":null,"Payload":{"QuestionText":"Provide any additional comments or suggestions regarding the wording of the glossary here.","DefaultChoices":false,"QuestionType":"TE","Selector":"ESTB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Provide any additional comments or suggestions regarding the wording of the glossary here.","Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"Provide any additional comments or suggestions regarding the wording of the glossary here.","DataExportTag":"Gloss Comments","QuestionID":"QID223"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID224","SecondaryAttribute":"Teleportation","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>Teleportation<\/h2>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Teleportation","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<h2>Entanglement<\/h2>","DataExportTag":"Teleportation Header","QuestionID":"QID224"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID225","SecondaryAttribute":"NOTE: We are repeating our glossary here for your convenience.","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong><span style=\"background-color:#f1c40f;\">NOTE: We are repeating our glossary here for your convenience.<\/span><\/strong><\/p>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"NOTE: We are repeating our glossary here for your convenience.","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<p><strong><span style=\"background-color:#f1c40f;\">NOTE: We are repeating our glossary here for your convenience.<\/span><\/strong><\/p>","DataExportTag":"Gloss Note","QuestionID":"QID225"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID226","SecondaryAttribute":"Glossary of Quantum Information Science Concepts","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>Glossary of Quantum Information Science Concepts<\/h2>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Glossary of Quantum Information Science Concepts","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<h2>Glossary of Quantum Information Science Concepts<\/h2>","DataVisibility":{"Private":false,"Hidden":false},"DataExportTag":"Gloss Header","QuestionID":"QID226"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID227","SecondaryAttribute":"As an emerging field, quantum information science has a rapidly developing vocabulary. In this te...","TertiaryAttribute":null,"Payload":{"QuestionText":"As an emerging field, quantum information science has a rapidly developing vocabulary. In this test, we use specific definitions that capture key concepts. More-general definitions may be encountered in advanced classes.&nbsp;The following glossary presents the specific definitions used through this test but does not contain all the information required to answer the questions.","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"As an emerging field, quantum information science has a rapidly developing vocabulary. In this te...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"As an emerging field, quantum information science has a rapidly developing vocabulary. In this test, we use specific definitions that capture key concepts. More-general definitions may be encountered in advanced classes.&nbsp;The following glossary presents the specific definitions used through this test but does not contain all the information required to answer the questions.","DataExportTag":"Gloss Explanation","QuestionID":"QID227"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID228","SecondaryAttribute":"Quantum Bit (a.k.a. Qubit):\u00a0The basic unit of quantum information. It is the quantum analogue of...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Quantum Bit<\/strong> (a.k.a. <strong>Qubit<\/strong>):&nbsp;The basic unit of quantum information. It is the quantum analogue of a classical bit, with two orthogonal basis states 0 and 1.<br>\n<br>\n<strong>Superposition<\/strong>: The ability of a quantum system to be in multiple basis states at the same time.<br>\n<br>\n<strong>Bloch Vector:<\/strong> A method of visualizing the state of a single qubit by converting information about its quantum state to a point on or within a sphere. For more than one qubit, the Bloch vector representation does not always provide complete information. A picture of a Bloch vector is shown here.<br>\n<img width=\"378\" style=\"width: 378px; height: 308px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_cwEn5lhVvyX0EcK\" height=\"308\"><br>\n<br>\n<strong>Quantum Circuit<\/strong>: A sequence of quantum operations applied to a system of qubits. A picture of a quantum circuit is shown here. The individual concepts (measurements, gates, etc.) are defined below.<br>\n<img width=\"563\" style=\"width: 563px; height: 211px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_eV6CPaQPQmay38q\" height=\"211\"><br>\n<br>\n<strong>Measurement<\/strong>: The act of examining the state of the system, which causes the system to collapse probabilistically to one of the basis states (0 or 1) of the measured qubit. <em>For this test, all measurements are assumed to be projective measurements of a single qubit in the computational basis.<\/em><br>\n<br>\n<strong>Quantum Gate<\/strong>: A quantum operation that can change the state of one or more qubits via a generalized rotation. <em>For this test, the term gate will be used exclusively for ideal unitary quantum gates.<\/em><br>\n<br>\n<strong>X Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the X axis.<br>\n&nbsp;<img width=\"103\" style=\"width: 103px; height: 46px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_0cwaF932gzHM6qO\" height=\"46\"><br>\n<br>\n<strong>Y Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the Y axis.<br>\n&nbsp;<img width=\"102\" style=\"width: 102px; height: 47px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_086ndZpcgMGT5mm\" height=\"47\"><br>\n<br>\n<strong>Z Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the Z axis.<br>\n&nbsp;<img width=\"103\" style=\"width: 103px; height: 50px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_8dJqo62BFUphAFw\" height=\"50\"><br>\n<br>\n<strong>S Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 90 degrees about the Z axis.<br>\n&nbsp;<img width=\"103\" style=\"width: 103px; height: 47px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_9KUpigbDM7odSwm\" height=\"47\"><br>\n<br>\n<strong>T Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 45 degrees about the Z axis.<br>\n&nbsp;<img width=\"103\" style=\"width: 103px; height: 46px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_bOx16xZhGtiQpBI\" height=\"46\"><br>\n<br>\n<strong>Hadamard (H) Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the X+Z axis.<br>\n&nbsp;<img width=\"103\" style=\"width: 103px; height: 46px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_cXWramA5VNfukD4\" height=\"46\"><br>\n<br>\n<strong>Controlled Not (CNOT) Gate<\/strong>: A two-qubit quantum gate that performs an X gate on the target qubit if and only if the control qubit is in state 1.<br>\n<img width=\"200\" style=\"width: 200px; height: 93px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_6tzjI6DxLbnDf8y\" height=\"93\"><br>\n<br>\n<strong>Entanglement<\/strong>: A fundamental quantum property in which the quantum state is shared among two or more qubits and not a property of any single qubit. When qubits are entangled, measurement of one qubit is influenced by measurements of the other qubits.<br>\n<br>\n<strong>Bell State<\/strong>: A specific two-qubit state that is maximally entangled. The four Bell states form a useful basis for describing two-qubit states.<br>\n<br>\n<strong>Quantum Teleportation<\/strong>: A procedure for transmitting quantum information from one location to another using entanglement. A picture of a canonical teleportation circuit is shown here.<br>\n<img width=\"711\" style=\"width: 711px; height: 192px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_cFHBzotmjj1OhCe\" height=\"192\"><br>\n<br>\n<strong>Decoherence<\/strong>: A process in which a quantum system's state loses information due to interactions with its surrounding environment. <em>For this test, all decoherence is assumed to be of Lindblad form (non-unitary, Markovian) such that dynamic decoupling does not protect against it. Noise from imperfect gates is considered as a form of decoherence.<\/em>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Quantum Bit (a.k.a. Qubit):\u00a0The basic unit of quantum information. It is the quantum analogue of...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false},"QuestionText_Unsafe":"<strong>Quantum Bit<\/strong> (a.k.a. <strong>Qubit<\/strong>):&nbsp;The basic unit of quantum information. It is the quantum analogue of a classical bit, with two orthogonal basis states 0 and 1.<br \/>\n<br \/>\n<strong>Superposition<\/strong>: The ability of a quantum system to be in multiple basis states at the same time.<br \/>\n<br \/>\n<strong>Bloch Vector:<\/strong> A method of visualizing the state of a single qubit by converting information about its quantum state to a point on or within a sphere. For more than one qubit, the Bloch vector representation does not always provide complete information. A picture of a Bloch vector is shown here.<br \/>\n<img height=\"308\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_cwEn5lhVvyX0EcK\" style=\"width: 378px; height: 308px;\" width=\"378\" \/><br \/>\n<br \/>\n<strong>Quantum Circuit<\/strong>: A sequence of quantum operations applied to a system of qubits. A picture of a quantum circuit is shown here. The individual concepts (measurements, gates, etc.) are defined below.<br \/>\n<img height=\"211\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_eV6CPaQPQmay38q\" style=\"width: 563px; height: 211px;\" width=\"563\" \/><br \/>\n<br \/>\n<strong>Measurement<\/strong>: The act of examining the state of the system, which causes the system to collapse probabilistically to one of the basis states (0 or 1) of the measured qubit. <em>For this test, all measurements are assumed to be projective measurements of a single qubit in the computational basis.<\/em><br \/>\n<br \/>\n<strong>Quantum Gate<\/strong>: A quantum operation that can change the state of one or more qubits via a generalized rotation. <em>For this test, the term gate will be used exclusively for ideal unitary quantum gates.<\/em><br \/>\n<br \/>\n<strong>X Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the X axis.<br \/>\n&nbsp;<img height=\"46\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_0cwaF932gzHM6qO\" style=\"width: 103px; height: 46px;\" width=\"103\" \/><br \/>\n<br \/>\n<strong>Y Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the Y axis.<br \/>\n&nbsp;<img height=\"47\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_086ndZpcgMGT5mm\" style=\"width: 102px; height: 47px;\" width=\"102\" \/><br \/>\n<br \/>\n<strong>Z Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the Z axis.<br \/>\n&nbsp;<img height=\"50\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_8dJqo62BFUphAFw\" style=\"width: 103px; height: 50px;\" width=\"103\" \/><br \/>\n<br \/>\n<strong>S Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 90 degrees about the Z axis.<br \/>\n&nbsp;<img height=\"47\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_9KUpigbDM7odSwm\" style=\"width: 103px; height: 47px;\" width=\"103\" \/><br \/>\n<br \/>\n<strong>T Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 45 degrees about the Z axis.<br \/>\n&nbsp;<img height=\"46\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_bOx16xZhGtiQpBI\" style=\"width: 103px; height: 46px;\" width=\"103\" \/><br \/>\n<br \/>\n<strong>Hadamard (H) Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the X+Z axis.<br \/>\n&nbsp;<img height=\"46\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_cXWramA5VNfukD4\" style=\"width: 103px; height: 46px;\" width=\"103\" \/><br \/>\n<br \/>\n<strong>Controlled Not (CNOT) Gate<\/strong>: A two-qubit quantum gate that performs an X gate on the target qubit if and only if the control qubit is in state 1.<br \/>\n<img height=\"93\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_6tzjI6DxLbnDf8y\" style=\"width: 200px; height: 93px;\" width=\"200\" \/><br \/>\n<br \/>\n<strong>Entanglement<\/strong>: A fundamental quantum property in which the quantum state is shared among two or more qubits and not a property of any single qubit. When qubits are entangled, the measurements of one qubit are is influenced by measurements of othersthe other qubits.<br \/>\n<br \/>\n<strong>Bell State<\/strong>: A specific two-qubit state that is maximally entangled. The four Bell states form a useful basis for describing two-qubit states.<br \/>\n<br \/>\n<strong>Quantum Teleportation<\/strong>: A procedure for transmitting quantum information from one location to another using entanglement. A picture of a canonical teleportation circuit is shown here.<br \/>\n<img height=\"192\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_cFHBzotmjj1OhCe\" style=\"width: 711px; height: 192px;\" width=\"711\" \/><br \/>\n<br \/>\n<strong>Decoherence<\/strong>: A process in which a quantum system&#39;s state loses information due to interactions with its surrounding environment. <em>For this test, all decoherence is assumed to be of Lindblad form (non-unitary, Markovian) such that dynamic decoupling does not protect against it. Noise from imperfect gates is considered as a form of decoherence.<\/em>","DataExportTag":"Gloss Contents","QuestionID":"QID228"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID229","SecondaryAttribute":"Provide any additional comments or suggestions regarding the wording of the glossary here.","TertiaryAttribute":null,"Payload":{"QuestionText":"Provide any additional comments or suggestions regarding the wording of the glossary here.","DefaultChoices":false,"QuestionType":"TE","Selector":"ESTB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Provide any additional comments or suggestions regarding the wording of the glossary here.","Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"Provide any additional comments or suggestions regarding the wording of the glossary here.","DataExportTag":"Gloss Comments","QuestionID":"QID229"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID23","SecondaryAttribute":"How can the following quantum teleportation circuit be modified to copy the initial state of qubi...","TertiaryAttribute":null,"Payload":{"QuestionText":"How can the following quantum teleportation circuit be modified to copy the initial state of qubit A to qubit C while maintaining the state at qubit A?<br \/>\n&nbsp;<img height=\"192\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_8wSOSx3kOesFWlM\" style=\"width: 711px; height: 192px;\" width=\"711\" \/>","DefaultChoices":false,"DataExportTag":"Q29","QuestionID":"QID23","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How can the following quantum teleportation circuit be modified to copy the initial state of qubi...","Choices":{"4":{"Display":"Repeat the protocol in reverse"},"5":{"Display":"Remove the measurement on qubit A"},"6":{"Display":"Such a modification is not possible"},"7":{"Display":"Replace the measurements with non-local quantum gates"}},"ChoiceOrder":["5","4","7","6"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[{"ChoiceID":"6","Grades":{"SC_0OJKeRemeTmXSm2":"1"},"index":0}],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"None"}}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID230","SecondaryAttribute":"Decoherence","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>Decoherence<\/h2>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Decoherence","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<h2>Teleportation<\/h2>","DataExportTag":"Decoherence Header","QuestionID":"QID230"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID231","SecondaryAttribute":"NOTE: We are repeating our glossary here for your convenience.","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong><span style=\"background-color:#f1c40f;\">NOTE: We are repeating our glossary here for your convenience.<\/span><\/strong><\/p>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"NOTE: We are repeating our glossary here for your convenience.","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<p><strong><span style=\"background-color:#f1c40f;\">NOTE: We are repeating our glossary here for your convenience.<\/span><\/strong><\/p>","DataExportTag":"Gloss Note","QuestionID":"QID231"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID232","SecondaryAttribute":"Glossary of Quantum Information Science Concepts","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>Glossary of Quantum Information Science Concepts<\/h2>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Glossary of Quantum Information Science Concepts","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<h2>Glossary of Quantum Information Science Concepts<\/h2>","DataVisibility":{"Private":false,"Hidden":false},"DataExportTag":"Gloss Header","QuestionID":"QID232"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID233","SecondaryAttribute":"As an emerging field, quantum information science has a rapidly developing vocabulary. In this te...","TertiaryAttribute":null,"Payload":{"QuestionText":"As an emerging field, quantum information science has a rapidly developing vocabulary. In this test, we use specific definitions that capture key concepts. More-general definitions may be encountered in advanced classes.&nbsp;The following glossary presents the specific definitions used through this test but does not contain all the information required to answer the questions.","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"As an emerging field, quantum information science has a rapidly developing vocabulary. In this te...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"As an emerging field, quantum information science has a rapidly developing vocabulary. In this test, we use specific definitions that capture key concepts. More-general definitions may be encountered in advanced classes.&nbsp;The following glossary presents the specific definitions used through this test but does not contain all the information required to answer the questions.","DataExportTag":"Gloss Explanation","QuestionID":"QID233"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID234","SecondaryAttribute":"Quantum Bit (a.k.a. Qubit):\u00a0The basic unit of quantum information. It is the quantum analogue of...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Quantum Bit<\/strong> (a.k.a. <strong>Qubit<\/strong>):&nbsp;The basic unit of quantum information. It is the quantum analogue of a classical bit, with two orthogonal basis states 0 and 1.<br>\n<br>\n<strong>Superposition<\/strong>: The ability of a quantum system to be in multiple basis states at the same time.<br>\n<br>\n<strong>Bloch Vector:<\/strong> A method of visualizing the state of a single qubit by converting information about its quantum state to a point on or within a sphere. For more than one qubit, the Bloch vector representation does not always provide complete information. A picture of a Bloch vector is shown here.<br>\n<img width=\"378\" style=\"width: 378px; height: 308px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_cwEn5lhVvyX0EcK\" height=\"308\"><br>\n<br>\n<strong>Quantum Circuit<\/strong>: A sequence of quantum operations applied to a system of qubits. A picture of a quantum circuit is shown here. The individual concepts (measurements, gates, etc.) are defined below.<br>\n<img width=\"563\" style=\"width: 563px; height: 211px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_eV6CPaQPQmay38q\" height=\"211\"><br>\n<br>\n<strong>Measurement<\/strong>: The act of examining the state of the system, which causes the system to collapse probabilistically to one of the basis states (0 or 1) of the measured qubit. <em>For this test, all measurements are assumed to be projective measurements of a single qubit in the computational basis.<\/em><br>\n<br>\n<strong>Quantum Gate<\/strong>: A quantum operation that can change the state of one or more qubits via a generalized rotation. <em>For this test, the term gate will be used exclusively for ideal unitary quantum gates.<\/em><br>\n<br>\n<strong>X Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the X axis.<br>\n&nbsp;<img width=\"103\" style=\"width: 103px; height: 46px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_0cwaF932gzHM6qO\" height=\"46\"><br>\n<br>\n<strong>Y Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the Y axis.<br>\n&nbsp;<img width=\"102\" style=\"width: 102px; height: 47px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_086ndZpcgMGT5mm\" height=\"47\"><br>\n<br>\n<strong>Z Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the Z axis.<br>\n&nbsp;<img width=\"103\" style=\"width: 103px; height: 50px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_8dJqo62BFUphAFw\" height=\"50\"><br>\n<br>\n<strong>S Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 90 degrees about the Z axis.<br>\n&nbsp;<img width=\"103\" style=\"width: 103px; height: 47px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_9KUpigbDM7odSwm\" height=\"47\"><br>\n<br>\n<strong>T Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 45 degrees about the Z axis.<br>\n&nbsp;<img width=\"103\" style=\"width: 103px; height: 46px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_bOx16xZhGtiQpBI\" height=\"46\"><br>\n<br>\n<strong>Hadamard (H) Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the X+Z axis.<br>\n&nbsp;<img width=\"103\" style=\"width: 103px; height: 46px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_cXWramA5VNfukD4\" height=\"46\"><br>\n<br>\n<strong>Controlled Not (CNOT) Gate<\/strong>: A two-qubit quantum gate that performs an X gate on the target qubit if and only if the control qubit is in state 1.<br>\n<img width=\"200\" style=\"width: 200px; height: 93px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_6tzjI6DxLbnDf8y\" height=\"93\"><br>\n<br>\n<strong>Entanglement<\/strong>: A fundamental quantum property in which the quantum state is shared among two or more qubits and not a property of any single qubit. When qubits are entangled, measurement of one qubit is influenced by measurements of the other qubits.<br>\n<br>\n<strong>Bell State<\/strong>: A specific two-qubit state that is maximally entangled. The four Bell states form a useful basis for describing two-qubit states.<br>\n<br>\n<strong>Quantum Teleportation<\/strong>: A procedure for transmitting quantum information from one location to another using entanglement. A picture of a canonical teleportation circuit is shown here.<br>\n<img width=\"711\" style=\"width: 711px; height: 192px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_cFHBzotmjj1OhCe\" height=\"192\"><br>\n<br>\n<strong>Decoherence<\/strong>: A process in which a quantum system's state loses information due to interactions with its surrounding environment. <em>For this test, all decoherence is assumed to be of Lindblad form (non-unitary, Markovian) such that dynamic decoupling does not protect against it. Noise from imperfect gates is considered as a form of decoherence.<\/em>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Quantum Bit (a.k.a. Qubit):\u00a0The basic unit of quantum information. It is the quantum analogue of...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false},"QuestionText_Unsafe":"<strong>Quantum Bit<\/strong> (a.k.a. <strong>Qubit<\/strong>):&nbsp;The basic unit of quantum information. It is the quantum analogue of a classical bit, with two orthogonal basis states 0 and 1.<br \/>\n<br \/>\n<strong>Superposition<\/strong>: The ability of a quantum system to be in multiple basis states at the same time.<br \/>\n<br \/>\n<strong>Bloch Vector:<\/strong> A method of visualizing the state of a single qubit by converting information about its quantum state to a point on or within a sphere. For more than one qubit, the Bloch vector representation does not always provide complete information. A picture of a Bloch vector is shown here.<br \/>\n<img height=\"308\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_cwEn5lhVvyX0EcK\" style=\"width: 378px; height: 308px;\" width=\"378\" \/><br \/>\n<br \/>\n<strong>Quantum Circuit<\/strong>: A sequence of quantum operations applied to a system of qubits. A picture of a quantum circuit is shown here. The individual concepts (measurements, gates, etc.) are defined below.<br \/>\n<img height=\"211\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_eV6CPaQPQmay38q\" style=\"width: 563px; height: 211px;\" width=\"563\" \/><br \/>\n<br \/>\n<strong>Measurement<\/strong>: The act of examining the state of the system, which causes the system to collapse probabilistically to one of the basis states (0 or 1) of the measured qubit. <em>For this test, all measurements are assumed to be projective measurements of a single qubit in the computational basis.<\/em><br \/>\n<br \/>\n<strong>Quantum Gate<\/strong>: A quantum operation that can change the state of one or more qubits via a generalized rotation. <em>For this test, the term gate will be used exclusively for ideal unitary quantum gates.<\/em><br \/>\n<br \/>\n<strong>X Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the X axis.<br \/>\n&nbsp;<img height=\"46\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_0cwaF932gzHM6qO\" style=\"width: 103px; height: 46px;\" width=\"103\" \/><br \/>\n<br \/>\n<strong>Y Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the Y axis.<br \/>\n&nbsp;<img height=\"47\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_086ndZpcgMGT5mm\" style=\"width: 102px; height: 47px;\" width=\"102\" \/><br \/>\n<br \/>\n<strong>Z Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the Z axis.<br \/>\n&nbsp;<img height=\"50\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_8dJqo62BFUphAFw\" style=\"width: 103px; height: 50px;\" width=\"103\" \/><br \/>\n<br \/>\n<strong>S Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 90 degrees about the Z axis.<br \/>\n&nbsp;<img height=\"47\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_9KUpigbDM7odSwm\" style=\"width: 103px; height: 47px;\" width=\"103\" \/><br \/>\n<br \/>\n<strong>T Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 45 degrees about the Z axis.<br \/>\n&nbsp;<img height=\"46\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_bOx16xZhGtiQpBI\" style=\"width: 103px; height: 46px;\" width=\"103\" \/><br \/>\n<br \/>\n<strong>Hadamard (H) Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the X+Z axis.<br \/>\n&nbsp;<img height=\"46\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_cXWramA5VNfukD4\" style=\"width: 103px; height: 46px;\" width=\"103\" \/><br \/>\n<br \/>\n<strong>Controlled Not (CNOT) Gate<\/strong>: A two-qubit quantum gate that performs an X gate on the target qubit if and only if the control qubit is in state 1.<br \/>\n<img height=\"93\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_6tzjI6DxLbnDf8y\" style=\"width: 200px; height: 93px;\" width=\"200\" \/><br \/>\n<br \/>\n<strong>Entanglement<\/strong>: A fundamental quantum property in which the quantum state is shared among two or more qubits and not a property of any single qubit. When qubits are entangled, the measurements of one qubit are is influenced by measurements of othersthe other qubits.<br \/>\n<br \/>\n<strong>Bell State<\/strong>: A specific two-qubit state that is maximally entangled. The four Bell states form a useful basis for describing two-qubit states.<br \/>\n<br \/>\n<strong>Quantum Teleportation<\/strong>: A procedure for transmitting quantum information from one location to another using entanglement. A picture of a canonical teleportation circuit is shown here.<br \/>\n<img height=\"192\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_cFHBzotmjj1OhCe\" style=\"width: 711px; height: 192px;\" width=\"711\" \/><br \/>\n<br \/>\n<strong>Decoherence<\/strong>: A process in which a quantum system&#39;s state loses information due to interactions with its surrounding environment. <em>For this test, all decoherence is assumed to be of Lindblad form (non-unitary, Markovian) such that dynamic decoupling does not protect against it. Noise from imperfect gates is considered as a form of decoherence.<\/em>","DataExportTag":"Gloss Contents","QuestionID":"QID234"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID235","SecondaryAttribute":"Provide any additional comments or suggestions regarding the wording of the glossary here.","TertiaryAttribute":null,"Payload":{"QuestionText":"Provide any additional comments or suggestions regarding the wording of the glossary here.","DefaultChoices":false,"QuestionType":"TE","Selector":"ESTB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Provide any additional comments or suggestions regarding the wording of the glossary here.","Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"Provide any additional comments or suggestions regarding the wording of the glossary here.","DataExportTag":"Gloss Comments","QuestionID":"QID235"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID236","SecondaryAttribute":"QIS Concept Introductory Test","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>QIS Concept Introductory Test<\/h2>","DefaultChoices":false,"DataExportTag":"QISCIT Header ","QuestionID":"QID236","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"QIS Concept Introductory Test","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID237","SecondaryAttribute":"Please answer the following questions to the best of your ability using your knowledge of quantum...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Please answer the following questions to the best of your ability using your knowledge of quantum information science and the glossary above.<\/strong>","DefaultChoices":false,"DataExportTag":"QISCIT Instructions","QuestionID":"QID237","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please answer the following questions to the best of your ability using your knowledge of quantum...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID239","SecondaryAttribute":"Please provide any comments or suggestions regarding the wording of the item above.","TertiaryAttribute":null,"Payload":{"QuestionText":"Please pr