es, you will be presented with a glossary of Quantum Information Science (QIS) concepts and a total of 34 questions. Please answer each question to the best of your ability.&nbsp;","QuestionType":"DB","Selector":"TB","Validation":{"Settings":{"Type":"None"}}}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID3","SecondaryAttribute":"How many potential superpositions exist for a single qubit?","TertiaryAttribute":null,"Payload":{"QuestionText":"How many potential superpositions exist for a single qubit?","DefaultChoices":false,"DataExportTag":"Q03","QuestionID":"QID3","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How many potential superpositions exist for a single qubit?","Choices":{"4":{"Display":"Zero"},"5":{"Display":"One"},"6":{"Display":"Two"},"7":{"Display":"Infinity"}},"ChoiceOrder":["4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[{"ChoiceID":"7","Grades":{"SC_0OJKeRemeTmXSm2":"1"},"index":0}],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"None"}}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID300","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DataExportTag":"Q196","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID300"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID301","SecondaryAttribute":"Name of College or University","TertiaryAttribute":null,"Payload":{"QuestionText":"Name of College or University","DefaultChoices":false,"DataExportTag":"University","QuestionType":"TE","Selector":"SL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Name of College or University","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID301"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID302","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DataExportTag":"Q198","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID302"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID303","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DataExportTag":"Q199","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID303"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID304","SecondaryAttribute":"QISCIT: A Quantum Information Science Concept Introductory Test","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:26px;\"><strong>QISCIT: A Quantum Information Science Concept Introductory Test<\/strong><\/span>","DefaultChoices":false,"DataExportTag":"Q200","QuestionID":"QID304","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"QISCIT: A Quantum Information Science Concept Introductory Test","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID52","SecondaryAttribute":"A qubit starts in state 0 and then has an H gate applied to it. If the qubit is then measured, wh...","TertiaryAttribute":null,"Payload":{"QuestionText":"A qubit starts in state 0 and then has an H gate applied to it. If the qubit is then measured, what is the probability it will return state 0?<br \/>\n&nbsp;<img height=\"51\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_54hKWJqKrN134rQ\" style=\"width: 203px; height: 51px;\" width=\"203\" \/>","DefaultChoices":false,"DataExportTag":"Q12","QuestionID":"QID52","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"A qubit starts in state 0 and then has an H gate applied to it. If the qubit is then measured, wh...","Choices":{"4":{"Display":"0%"},"5":{"Display":"50%"},"6":{"Display":"100%"},"7":{"Display":"25%"},"8":{"Display":"75%"}},"ChoiceOrder":["4","7","5","8","6"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[{"ChoiceID":"5","Grades":{"SC_0OJKeRemeTmXSm2":"1"},"index":0}],"Language":[],"NextChoiceId":9,"NextAnswerId":1,"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"None"},"AnalyzeChoices":{"7":"on"}}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID70","SecondaryAttribute":"When are ideal quantum gates not reversible?","TertiaryAttribute":null,"Payload":{"QuestionText":"When are ideal quantum gates not reversible?","DefaultChoices":false,"DataExportTag":"Q10","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"When are ideal quantum gates not reversible?","Choices":{"5":{"Display":"Only when the qubits are entangled"},"7":{"Display":"Only when the qubits are in superpositions"},"8":{"Display":"Quantum gates are always reversible"},"9":{"Display":"Quantum gates are never reversible"}},"ChoiceOrder":["5","7","8","9"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"None"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[{"ChoiceID":"8","Grades":{"SC_0OJKeRemeTmXSm2":"1"},"index":0}],"Language":[],"NextChoiceId":10,"NextAnswerId":1,"QuestionID":"QID70"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID71","SecondaryAttribute":"Expert Information","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>Expert Information<\/h2>","DefaultChoices":false,"DataExportTag":"EV Header","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Expert Information","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID71","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID84","SecondaryAttribute":"Purpose","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>Purpose<\/h2>","DefaultChoices":false,"DataExportTag":"Purpose Header","QuestionID":"QID84","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Purpose","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID85","SecondaryAttribute":"On the following pages, you will be presented with the second version of QISCIT, which includes a...","TertiaryAttribute":null,"Payload":{"QuestionText":"On the following pages, you will be presented with the <strong><span style=\"background-color:#f1c40f;\">second version of QISCIT<\/span><\/strong>, which includes a glossary of QIS concepts and <strong><span style=\"background-color:#f1c40f;\">a total of 34 questions<\/span><\/strong> grouped by primary concept for your convenience. For each item, we ask that you <strong><span style=\"background-color:#f1c40f;\">rate<\/span><\/strong><span style=\"background-color:#f1c40f;\"> the item&nbsp;based on content relevance from 1 (&quot;Not Relevant&quot;) to 4 (&quot;Extremely Relevant&quot;)<\/span> and <strong><span style=\"background-color:#f1c40f;\">provide&nbsp;comments<\/span><\/strong><span style=\"background-color:#f1c40f;\"> and make suggestions regarding the wording of the item<\/span>.<br \/>\n<br \/>\n<strong><span style=\"background-color:#f1c40f;\">Note, the groups of questions will be randomized to mitigate potential learning effects due to ordering.<\/span><\/strong>","DefaultChoices":false,"DataExportTag":"Instructions Text","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"On the following pages, you will be presented with the second version of QISCIT, which includes a...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID85","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID86","SecondaryAttribute":"Glossary of Quantum Information Science Concepts","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>Glossary of Quantum Information Science Concepts<\/h2>","DefaultChoices":false,"DataExportTag":"Gloss Header","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Glossary of Quantum Information Science Concepts","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID86","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID88","SecondaryAttribute":"Quantum Bit (a.k.a. Qubit):\u00a0The basic unit of quantum information. It is the quantum analogue of...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Quantum Bit<\/strong> (a.k.a. <strong>Qubit<\/strong>):&nbsp;The basic unit of quantum information. It is the quantum analogue of a classical bit, with two orthogonal basis states 0 and 1.<br>\n<br>\n<strong>Superposition<\/strong>: The ability of a quantum system to be in multiple basis states at the same time.<br>\n<br>\n<strong>Bloch Vector:<\/strong> A method of visualizing the state of a single qubit by converting information about its quantum state to a point on or within a sphere. For more than one qubit, the Bloch vector representation does not always provide complete information. A picture of a Bloch vector is shown here.<br>\n<img width=\"378\" style=\"width: 378px; height: 308px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_cwEn5lhVvyX0EcK\" height=\"308\"><br>\n<br>\n<strong>Quantum Circuit<\/strong>: A sequence of quantum operations applied to a system of qubits. A picture of a quantum circuit is shown here. The individual concepts (measurements, gates, etc.) are defined below.<br>\n<img width=\"563\" style=\"width: 563px; height: 211px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_eV6CPaQPQmay38q\" height=\"211\"><br>\n<br>\n<strong>Measurement<\/strong>: The act of examining the state of the system, which causes the system to collapse probabilistically to one of the basis states (0 or 1) of the measured qubit. <em>For this test, all measurements are assumed to be projective measurements of a single qubit in the computational basis.<\/em><br>\n<br>\n<strong>Quantum Gate<\/strong>: A quantum operation that can change the state of one or more qubits via a generalized rotation. <em>For this test, the term gate will be used exclusively for ideal unitary quantum gates.<\/em><br>\n<br>\n<strong>X Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the X axis.<br>\n&nbsp;<img width=\"103\" style=\"width: 103px; height: 46px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_0cwaF932gzHM6qO\" height=\"46\"><br>\n<br>\n<strong>Y Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the Y axis.<br>\n&nbsp;<img width=\"102\" style=\"width: 102px; height: 47px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_086ndZpcgMGT5mm\" height=\"47\"><br>\n<br>\n<strong>Z Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the Z axis.<br>\n&nbsp;<img width=\"103\" style=\"width: 103px; height: 50px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_8dJqo62BFUphAFw\" height=\"50\"><br>\n<br>\n<strong>S Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 90 degrees about the Z axis.<br>\n&nbsp;<img width=\"103\" style=\"width: 103px; height: 47px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_9KUpigbDM7odSwm\" height=\"47\"><br>\n<br>\n<strong>T Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 45 degrees about the Z axis.<br>\n&nbsp;<img width=\"103\" style=\"width: 103px; height: 46px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_bOx16xZhGtiQpBI\" height=\"46\"><br>\n<br>\n<strong>Hadamard (H) Gate<\/strong>: A quantum gate that rotates the Bloch vector of a single qubit by 180 degrees about the X+Z axis.<br>\n&nbsp;<img width=\"103\" style=\"width: 103px; height: 46px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_cXWramA5VNfukD4\" height=\"46\"><br>\n<br>\n<strong>Controlled Not (CNOT) Gate<\/strong>: A two-qubit quantum gate that performs an X gate on the target qubit if and only if the control qubit is in state 1.<br>\n<img width=\"200\" style=\"width: 200px; height: 93px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_6tzjI6DxLbnDf8y\" height=\"93\"><br>\n<br>\n<strong>Entanglement<\/strong>: A fundamental quantum property in which the quantum state is shared among two or more qubits and not a property of any single qubit. When qubits are entangled, measurement of one qubit is influenced by measurements of the other qubits.<br>\n<br>\n<strong>Bell State<\/strong>: A specific two-qubit state that is maximally entangled. The four Bell states form a useful basis for describing two-qubit states.<br>\n<br>\n<strong>Quantum Teleportation<\/strong>: A procedure for transmitting quantum information from one location to another using entanglement. A picture of a canonical teleportation circuit is shown here.<br>\n<img width=\"711\" style=\"width: 711px; height: 192px;\" src=\"https:\/\/ucf.qualtrics.com\/\/CP\/Graphic.php?IM=IM_cFHBzotmjj1OhCe\" height=\"192\"><br>\n<br>\n<strong>Decoherence<\/strong>: Any process in which a quantum system's state loses information due to interactions with its surrounding environment, such as qubit dephasing and relaxation. <em>For this test, all decoherence is assumed to be of Lindblad form (non-unitary, Markovian) such that dynamic decoupling does not protect against it. Noise from imperfect gates is considered as a form of decoherence.<\/em>","DefaultChoices":false,"DataExportTag":"Gloss Contents","QuestionID":"QID88","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Quantum Bit (a.k.a. Qubit):\u00a0The basic unit of quantum information. It is the quantum analogue of...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID92","SecondaryAttribute":"Qubits","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>Qubits<\/h2>","DefaultChoices":false,"DataExportTag":"Qubits Header","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Qubits","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID92"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID95","SecondaryAttribute":"First Name","TertiaryAttribute":null,"Payload":{"QuestionText":"First Name","DefaultChoices":false,"DataExportTag":"First Name","QuestionID":"QID95","QuestionType":"TE","Selector":"SL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"First Name","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID96","SecondaryAttribute":"Last Name","TertiaryAttribute":null,"Payload":{"QuestionText":"Last Name","DefaultChoices":false,"DataExportTag":"Last Name","QuestionType":"TE","Selector":"SL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Last Name","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID96"}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID97","SecondaryAttribute":"Position Title","TertiaryAttribute":null,"Payload":{"QuestionText":"Position Title","DefaultChoices":false,"DataExportTag":"Position Title","QuestionID":"QID97","QuestionType":"TE","Selector":"SL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Position Title","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"SQ","PrimaryAttribute":"QID98","SecondaryAttribute":"Organization \/ University","TertiaryAttribute":null,"Payload":{"QuestionText":"Organization \/ University<br>","DefaultChoices":false,"DataExportTag":"Organization","QuestionID":"QID98","QuestionType":"TE","Selector":"SL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Organization \/ University","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_bplvfnzNXICV10G","Element":"STAT","PrimaryAttribute":"Survey Statistics","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"MobileCompatible":true,"ID":"Survey Statistics"}}]}